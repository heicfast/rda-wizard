<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      HIGH-CONTRAST theme — generated from tokens.json (v1.0.0).
      @-tokens resolve to WPF SystemColors DynamicResources so real Windows HC themes
      remap colors at the OS level. Semantic statuses use high-visibility literals.
      Elevation effects are OFF (flat + border depth). Key parity with Light/Dark enforced.
      GENERATED FILE — do not edit by hand. Source of truth: design/tokens.json
      (regenerate: node design/generate-tokens.mjs). Tokens v1.0.0.
      Evidence keys (QSS/TDI/VE/QE/ADV) are recorded per-key in design/tokens.json;
      see docs/VISUAL-SPEC.md for the authority order and rationale.
    -->

    <!-- ===== Brand / interaction ===== -->
    <SolidColorBrush x:Key="Brush.Brand.Primary" Color="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Brand.Hover" Color="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Brand.Pressed" Color="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Brand.Deep" Color="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Brand.Interaction" Color="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Brand.LinkPressed" Color="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Brand.On" Color="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Brand.Focus" Color="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Brand.Outline" Color="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Brand.OutlineHover" Color="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Brand.OutlineFill" Color="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Brand.SecondaryPressed" Color="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
    <SolidColorBrush x:Key="Brush.BrandTint" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="Brush.BrandTintStrong" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="Brush.Brand.SecondaryFg" Color="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />

    <!-- ===== Status semantics ===== -->
    <SolidColorBrush x:Key="Brush.Status.Success" Color="#FF00CC66" />
    <SolidColorBrush x:Key="Brush.Status.SuccessText" Color="#FF00CC66" />
    <SolidColorBrush x:Key="Brush.Status.SuccessBg" Color="#FF002D14" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="#FFFFFF00" />
    <SolidColorBrush x:Key="Brush.Status.WarningText" Color="#FFFFFF00" />
    <SolidColorBrush x:Key="Brush.Status.WarningBg" Color="#FF3D3800" />
    <SolidColorBrush x:Key="Brush.Status.WarningStrong" Color="#FFFFFF00" />
    <SolidColorBrush x:Key="Brush.Status.Danger" Color="#FFFF3333" />
    <SolidColorBrush x:Key="Brush.Status.DangerAlt" Color="#FFFF3333" />
    <SolidColorBrush x:Key="Brush.Status.DangerPressed" Color="#FFCC0000" />
    <SolidColorBrush x:Key="Brush.Status.DangerBg" Color="#FF3D0000" />
    <SolidColorBrush x:Key="Brush.Status.DangerText" Color="#FFFF3333" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Status.DangerFill" Color="#FFFF3333" />
    <SolidColorBrush x:Key="Brush.Status.DangerOn" Color="#FFFFFFFF" />

    <!-- ===== Backgrounds ===== -->
    <SolidColorBrush x:Key="Brush.Bg.Window" Color="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Bg.WindowEdge" Color="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Bg.Canvas" Color="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Bg.Surface" Color="#FF181818" />
    <SolidColorBrush x:Key="Brush.Bg.SurfaceAlt" Color="#FF282828" />
    <SolidColorBrush x:Key="Brush.Bg.Card" Color="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Bg.CardHover" Color="#FF303030" />
    <SolidColorBrush x:Key="Brush.Bg.Elevated" Color="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Bg.Overlay" Color="#C8000000" />
    <SolidColorBrush x:Key="Brush.Bg.Sidebar" Color="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Bg.SearchStrip" Color="#FF282828" />
    <SolidColorBrush x:Key="Brush.Bg.Tooltip" Color="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Bg.SelectedRow" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="Brush.Bg.Menu" Color="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Bg.SidebarHover" Color="#FF303030" />
    <SolidColorBrush x:Key="Brush.Bg.SidebarSelected" Color="#38FFFFFF" />

    <!-- ===== Text ===== -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Text.Link" Color="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Text.LinkPressed" Color="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Text.Inverse" Color="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />

    <!-- ===== Borders & dividers ===== -->
    <SolidColorBrush x:Key="Brush.Border.Hairline" Color="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Border.Selected" Color="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Border.Glass" Color="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Border.Danger" Color="#FFFF3333" />
    <SolidColorBrush x:Key="Brush.Border.SidebarSeparator" Color="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />

    <!-- ===== Blue tint ladder (hover/selected fills) ===== -->
    <SolidColorBrush x:Key="Brush.Tint.T1" Color="#FF282828" />
    <SolidColorBrush x:Key="Brush.Tint.T2" Color="#FF282828" />
    <SolidColorBrush x:Key="Brush.Tint.T3" Color="#FF303030" />
    <SolidColorBrush x:Key="Brush.Tint.T4" Color="#FF383838" />
    <SolidColorBrush x:Key="Brush.Tint.T5" Color="#FF404040" />

    <!-- ===== Disabled states ===== -->
    <SolidColorBrush x:Key="Brush.Disabled.Fill" Color="#FF404040" />
    <SolidColorBrush x:Key="Brush.Disabled.FillStrong" Color="#FF404040" />
    <SolidColorBrush x:Key="Brush.Disabled.Text" Color="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

    <!-- ===== Confidence badges (recovery-chance language) ===== -->
    <SolidColorBrush x:Key="Brush.Confidence.Excellent.Bg" Color="#FF002D14" />
    <SolidColorBrush x:Key="Brush.Confidence.Excellent.Fg" Color="#FF00CC66" />
    <SolidColorBrush x:Key="Brush.Confidence.Partial.Bg" Color="#FF3D3800" />
    <SolidColorBrush x:Key="Brush.Confidence.Partial.Fg" Color="#FFFFFF00" />
    <SolidColorBrush x:Key="Brush.Confidence.Overwritten.Bg" Color="#FF3D0000" />
    <SolidColorBrush x:Key="Brush.Confidence.Overwritten.Fg" Color="#FFFF3333" />
    <SolidColorBrush x:Key="Brush.Confidence.MetadataOnly.Bg" Color="#FF282828" />
    <SolidColorBrush x:Key="Brush.Confidence.MetadataOnly.Fg" Color="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Confidence.Unknown.Bg" Color="#FF282828" />
    <SolidColorBrush x:Key="Brush.Confidence.Unknown.Fg" Color="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

    <!-- ===== Health-gauge bands ===== -->
    <SolidColorBrush x:Key="Brush.Health.Good" Color="#FF00CC66" />
    <SolidColorBrush x:Key="Brush.Health.Caution" Color="#FFFFFF00" />
    <SolidColorBrush x:Key="Brush.Health.Bad" Color="#FFFF3333" />
    <SolidColorBrush x:Key="Brush.Health.Unknown" Color="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

    <!-- ===== Chart accents (8 result categories) ===== -->
    <SolidColorBrush x:Key="Brush.Chart.1" Color="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Chart.2" Color="#FFFF7342" />
    <SolidColorBrush x:Key="Brush.Chart.3" Color="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Chart.4" Color="#FF89C5DA" />
    <SolidColorBrush x:Key="Brush.Chart.5" Color="#FFFFB025" />
    <SolidColorBrush x:Key="Brush.Chart.6" Color="#FF00CC66" />
    <SolidColorBrush x:Key="Brush.Chart.7" Color="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    <SolidColorBrush x:Key="Brush.Chart.8" Color="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

    <!-- ===== Misc ===== -->
    <SolidColorBrush x:Key="Brush.Shadow.Hue" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.Splash.Status" Color="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

    <!-- ===== Gradients ===== -->
    <SolidColorBrush x:Key="Brush.Cta" Color="#FF0C99FF" />
    <SolidColorBrush x:Key="Brush.WindowHero" Color="#FFEFF5FF" />
    <SolidColorBrush x:Key="Brush.Upgrade" Color="#FF89BEFF" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFFCE7DF" />
    <SolidColorBrush x:Key="Brush.ProgressFill" Color="#FF0C99FF" />
    <SolidColorBrush x:Key="Brush.GaugeArc" Color="#FF0C99FF" />

    <!-- ===== Elevation (DropShadowEffects) ===== -->
    <DropShadowEffect x:Key="Effect.Elevation.Card" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#FF000000" />
    <DropShadowEffect x:Key="Effect.Elevation.CardHover" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#FF000000" />
    <DropShadowEffect x:Key="Effect.Elevation.Flyout" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#FF000000" />
    <DropShadowEffect x:Key="Effect.Elevation.Dialog" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#FF000000" />
    <DropShadowEffect x:Key="Effect.Elevation.Window" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#FF000000" />
    <DropShadowEffect x:Key="Effect.FocusGlow" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#FF000000" />
</ResourceDictionary>
