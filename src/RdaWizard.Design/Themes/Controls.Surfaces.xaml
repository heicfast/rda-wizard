<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Surface primitives: Card, Panel, Section header, Banner strip styles,
      Dialog shell, Overlay scrim, ResizeGrip.
      Specs: DESIGN-SYSTEM §8.14–8.15; VISUAL-SPEC §3. Banner = 48px strip,
      4px severity accent bar, r8, icon+title+body+action.
    -->

    <!-- ===== Card (resting surface: white/dark-card, hairline border, r8) ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Padding" Value="{DynamicResource Space.XL}" />
    </Style>

    <!-- Card interactive (drive tiles: hover lift + brand border; QSS L1761 blur-12 shadow) -->
    <Style x:Key="Card.Interactive" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Bg.CardHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Selected}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card selected (blue border + tint wash; atlas §5 tile selection) -->
    <Style x:Key="Card.Selected" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Selected}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.CardHover}" />
    </Style>

    <!-- ===== Panel (sub-surface: inset panels, table shells) ===== -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Padding" Value="{DynamicResource Space.L}" />
    </Style>

    <!-- ===== Section header (H2 + optional count; 16px tertiary, QSS L1676) ===== -->
    <Style x:Key="Section.Header" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Subtitle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ===== Divider (hairline, 1px) ===== -->
    <Style x:Key="Divider" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Border.Hairline}" />
    </Style>

    <!-- ===== Banner severity accent bar (4px, full height, left edge) ===== -->
    <!-- Banners render as: <Border Style=BannerRoot><Grid><Rectangle style accent/><content/> -->

    <!-- ===== Dialog shell (modal surface: r12, dialog elevation, 540 default) ===== -->
    <Style x:Key="Dialog.Surface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Window}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Dialog}" />
        <Setter Property="MinWidth" Value="{DynamicResource Dialog.DefaultWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource Dialog.MaxWidth}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect" Value="{DynamicResource Effect.Elevation.Dialog}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===== Overlay scrim (modal backdrop; click-swallow by host, DESIGN P5) ===== -->
    <Style x:Key="Overlay.Scrim" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Overlay}" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- ===== ResizeGrip (custom-drawn, hairline dots) ===== -->
    <Style x:Key="ResizeGrip" TargetType="ResizeGrip">
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Cursor" Value="SizeNWSE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ResizeGrip">
                    <Grid Background="Transparent">
                        <Path Data="M 12 4 L 14 4 L 14 6 Z M 8 8 L 10 8 L 10 10 L 8 10 Z M 12 8 L 14 8 L 14 10 L 12 10 Z M 4 12 L 6 12 L 6 14 L 4 14 Z M 8 12 L 10 12 L 10 14 L 8 14 Z M 12 12 L 14 12 L 14 14 L 12 14 Z"
                              Fill="{DynamicResource Brush.Text.Tertiary}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Opacity="0.6" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
