<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      DARK theme — color tokens from docs/DESIGN-SYSTEM.md §2 token tables
      (themdark.ini 118-slot ground truth: surfaces #1B1D1F/#202428/#32383E,
      borders #404C63/#596680, text #F1F5FF; CTA gradient #059AFD→#0CCDFF).
      Keys are EXACT counterparts of Theme.Light.xaml.
    -->

    <!-- ===== Brand ===== -->
    <SolidColorBrush x:Key="Brush.Brand.Primary" Color="#5094FF" />
    <SolidColorBrush x:Key="Brush.Brand.Hover" Color="#68B4FF" />
    <SolidColorBrush x:Key="Brush.Brand.Pressed" Color="#3874FF" />
    <SolidColorBrush x:Key="Brush.Brand.Deep" Color="#284A7F" />
    <SolidColorBrush x:Key="Brush.Brand.Interaction" Color="#A8CAFF" />
    <SolidColorBrush x:Key="Brush.Brand.LinkPressed" Color="#669EFE" />
    <SolidColorBrush x:Key="Brush.Brand.On" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Brand.Focus" Color="#669EFE" />

    <LinearGradientBrush x:Key="Brush.Cta" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#059AFD" Offset="0" />
        <GradientStop Color="#0CCDFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.WindowHero" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B1D1F" Offset="0" />
        <GradientStop Color="#18191B" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.BrandTint" Color="#1AC6DEFF" />
    <SolidColorBrush x:Key="Brush.BrandTintStrong" Color="#338DBDFF" />

    <!-- ===== Status ===== -->
    <SolidColorBrush x:Key="Brush.Status.Success" Color="#349A37" />
    <SolidColorBrush x:Key="Brush.Status.SuccessText" Color="#5BC98A" />
    <SolidColorBrush x:Key="Brush.Status.SuccessBg" Color="#1F3A26" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="#FFC764" />
    <SolidColorBrush x:Key="Brush.Status.WarningText" Color="#FFC764" />
    <SolidColorBrush x:Key="Brush.Status.WarningBg" Color="#47433E" />
    <SolidColorBrush x:Key="Brush.Status.WarningStrong" Color="#D6890B" />
    <SolidColorBrush x:Key="Brush.Status.Danger" Color="#FF5A5A" />
    <SolidColorBrush x:Key="Brush.Status.DangerAlt" Color="#FF8C8C" />
    <SolidColorBrush x:Key="Brush.Status.DangerPressed" Color="#E5484D" />
    <SolidColorBrush x:Key="Brush.Status.DangerBg" Color="#652C2D" />
    <SolidColorBrush x:Key="Brush.Status.DangerText" Color="#FF8C8C" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="#5094FF" />

    <!-- ===== Backgrounds ===== -->
    <SolidColorBrush x:Key="Brush.Bg.Window" Color="#1B1D1F" />
    <SolidColorBrush x:Key="Brush.Bg.WindowEdge" Color="#141516" />
    <SolidColorBrush x:Key="Brush.Bg.Canvas" Color="#202428" />
    <SolidColorBrush x:Key="Brush.Bg.Surface" Color="#252B33" />
    <SolidColorBrush x:Key="Brush.Bg.SurfaceAlt" Color="#2F3847" />
    <SolidColorBrush x:Key="Brush.Bg.Card" Color="#202428" />
    <SolidColorBrush x:Key="Brush.Bg.CardHover" Color="#2A313A" />
    <SolidColorBrush x:Key="Brush.Bg.Elevated" Color="#32383E" />
    <SolidColorBrush x:Key="Brush.Bg.Overlay" Color="#8C000000" />
    <SolidColorBrush x:Key="Brush.Bg.Sidebar" Color="#252B33" />
    <SolidColorBrush x:Key="Brush.Bg.SearchStrip" Color="#31405C" />
    <SolidColorBrush x:Key="Brush.Bg.Tooltip" Color="#EB0560FD" />
    <SolidColorBrush x:Key="Brush.Bg.SelectedRow" Color="#1A8DBDFF" />

    <!-- ===== Text ===== -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F1F5FF" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#B0B5C0" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#7B808A" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#596680" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Text.Link" Color="#A8CAFF" />
    <SolidColorBrush x:Key="Brush.Text.LinkPressed" Color="#669EFE" />
    <SolidColorBrush x:Key="Brush.Text.Inverse" Color="#0B1220" />

    <!-- ===== Borders ===== -->
    <SolidColorBrush x:Key="Brush.Border.Hairline" Color="#313237" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="#404C63" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#596680" />
    <SolidColorBrush x:Key="Brush.Border.Selected" Color="#5094FF" />
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="#669EFE" />
    <SolidColorBrush x:Key="Brush.Border.Glass" Color="#338DBDFF" />
    <SolidColorBrush x:Key="Brush.Border.Danger" Color="#FF5A5A" />

    <!-- ===== Confidence badges ===== -->
    <SolidColorBrush x:Key="Brush.Confidence.Excellent.Bg" Color="#1F3A26" />
    <SolidColorBrush x:Key="Brush.Confidence.Excellent.Fg" Color="#5BC98A" />
    <SolidColorBrush x:Key="Brush.Confidence.Partial.Bg" Color="#47433E" />
    <SolidColorBrush x:Key="Brush.Confidence.Partial.Fg" Color="#FFC764" />
    <SolidColorBrush x:Key="Brush.Confidence.Overwritten.Bg" Color="#652C2D" />
    <SolidColorBrush x:Key="Brush.Confidence.Overwritten.Fg" Color="#FF8C8C" />
    <SolidColorBrush x:Key="Brush.Confidence.MetadataOnly.Bg" Color="#2F3847" />
    <SolidColorBrush x:Key="Brush.Confidence.MetadataOnly.Fg" Color="#B0B5C0" />
    <SolidColorBrush x:Key="Brush.Confidence.Unknown.Bg" Color="#2F3847" />
    <SolidColorBrush x:Key="Brush.Confidence.Unknown.Fg" Color="#7B808A" />

    <!-- ===== Health gauge bands ===== -->
    <SolidColorBrush x:Key="Brush.Health.Good" Color="#349A37" />
    <SolidColorBrush x:Key="Brush.Health.Caution" Color="#FFC764" />
    <SolidColorBrush x:Key="Brush.Health.Bad" Color="#FF5A5A" />
    <SolidColorBrush x:Key="Brush.Health.Unknown" Color="#596680" />

    <!-- ===== Elevation (dark: shadows read as near-black; borders carry depth) ===== -->
    <DropShadowEffect x:Key="Effect.Elevation.Card" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#000000" />
    <DropShadowEffect x:Key="Effect.Elevation.CardHover" BlurRadius="12" ShadowDepth="4" Direction="270"
                      Opacity="0.40" Color="#000000" />
    <DropShadowEffect x:Key="Effect.Elevation.Flyout" BlurRadius="24" ShadowDepth="8" Direction="270"
                      Opacity="0.50" Color="#000000" />
    <DropShadowEffect x:Key="Effect.Elevation.Dialog" BlurRadius="48" ShadowDepth="16" Direction="270"
                      Opacity="0.55" Color="#000000" />
    <DropShadowEffect x:Key="Effect.Elevation.Window" BlurRadius="60" ShadowDepth="20" Direction="270"
                      Opacity="0.60" Color="#000000" />

</ResourceDictionary>
