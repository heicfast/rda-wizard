<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      Design tokens: sizes, spacing, radii, motion durations.
      Theme-INDEPENDENT (identical in light and dark). Colors live in
      Theme.Light.xaml / Theme.Dark.xaml; everything here is geometry and time.
      Source of truth: docs/DESIGN-SYSTEM.md §4/§5/§8 (token tables
      extracted from the DRW QSS census, [ADAPTATION] markers included).
    -->

    <!-- ===== Spacing (4px base grid) ===== -->
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.S">8</sys:Double>
    <sys:Double x:Key="Space.M">12</sys:Double>
    <sys:Double x:Key="Space.L">16</sys:Double>
    <sys:Double x:Key="Space.XL">24</sys:Double>
    <sys:Double x:Key="Space.XXL">32</sys:Double>
    <sys:Double x:Key="Space.Page">48</sys:Double>

    <!-- ===== Control heights ===== -->
    <sys:Double x:Key="Height.XS">32</sys:Double>
    <sys:Double x:Key="Height.S">28</sys:Double>
    <sys:Double x:Key="Height.M">32</sys:Double>
    <sys:Double x:Key="Height.L">36</sys:Double>
    <sys:Double x:Key="Height.Header">40</sys:Double>
    <sys:Double x:Key="Height.Row">44</sys:Double>
    <sys:Double x:Key="Height.TitleBar">40</sys:Double>
    <sys:Double x:Key="Height.Toolbar">48</sys:Double>
    <sys:Double x:Key="Height.StatusBar">88</sys:Double>
    <sys:Double x:Key="Width.Sidebar">220</sys:Double>
    <sys:Double x:Key="Width.SidebarCollapsed">48</sys:Double>

    <!-- ===== Corner radii ===== -->
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.ControlL">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">12</CornerRadius>
    <CornerRadius x:Key="Radius.Window">8</CornerRadius>
    <CornerRadius x:Key="Radius.Splash">20</CornerRadius>
    <CornerRadius x:Key="Radius.Badge">999</CornerRadius>

    <!-- ===== Typography ramp (Segoe UI Variable → Segoe UI fallback; Win7-safe) ===== -->
    <!-- Font sizes in WPF are device-independent px @96dpi. -->
    <sys:Double x:Key="Font.Size.Display">28</sys:Double>
    <sys:Double x:Key="Font.Size.Title">22</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">16</sys:Double>
    <sys:Double x:Key="Font.Size.Body">14</sys:Double>
    <sys:Double x:Key="Font.Size.Caption">12</sys:Double>
    <sys:Double x:Key="Font.Size.CaptionStrong">13</sys:Double>
    <sys:Double x:Key="Font.Size.Micro">11</sys:Double>

    <FontFamily x:Key="Font.Family">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Family.Body">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Family.Mono">Consolas, Cascadia Mono, Courier New</FontFamily>

    <!-- ===== Motion durations (ms) — reduce-motion collapses these to 0 ===== -->
    <sys:Double x:Key="Motion.PageTransition">300</sys:Double>
    <sys:Double x:Key="Motion.PanelOpen">250</sys:Double>
    <sys:Double x:Key="Motion.PanelClose">200</sys:Double>
    <sys:Double x:Key="Motion.Hover">120</sys:Double>
    <sys:Double x:Key="Motion.Press">80</sys:Double>
    <sys:Double x:Key="Motion.ProgressSmoothing">300</sys:Double>
    <sys:Double x:Key="Motion.ShimmerLoop">1600</sys:Double>

    <!-- ===== Icon sizes ===== -->
    <sys:Double x:Key="Icon.Size.S">16</sys:Double>
    <sys:Double x:Key="Icon.Size.M">20</sys:Double>
    <sys:Double x:Key="Icon.Size.L">24</sys:Double>
    <sys:Double x:Key="Icon.Size.XL">32</sys:Double>

    <!-- ===== Window metrics ===== -->
    <sys:Double x:Key="Window.MinWidth">800</sys:Double>
    <sys:Double x:Key="Window.MinHeight">600</sys:Double>
    <sys:Double x:Key="Window.DefaultWidth">1240</sys:Double>
    <sys:Double x:Key="Window.DefaultHeight">840</sys:Double>
    <sys:Double x:Key="Content.MaxWidth">899</sys:Double>
    <sys:Double x:Key="Coaching.MaxWidth">720</sys:Double>

</ResourceDictionary>
