    <Thickness x:Key="Space.XXL">32</Thickness>
    <Thickness x:Key="Space.Page">48</Thickness>
    <Thickness x:Key="Space.2">2</Thickness>

    <!-- ===== Control heights ===== -->
    <sys:Double x:Key="Height.XS">32</sys:Double>
    <sys:Double x:Key="Height.S">28</sys:Double>
    <sys:Double x:Key="Height.M">32</sys:Double>
    <sys:Double x:Key="Height.L">36</sys:Double>
    <sys:Double x:Key="Height.Header">40</sys:Double>
    <sys:Double x:Key="Height.Row">44</sys:Double>
    <sys:Double x:Key="Height.TitleBar">40</sys:Double>
    <sys:Double x:Key="Height.Toolbar">48</sys:Double>
    <sys:Double x:Key="Height.StatusBar">88</sys:Double>
    <sys:Double x:Key="Height.SidebarRow">48</sys:Double>
    <sys:Double x:Key="Height.MenuItem">36</sys:Double>
    <sys:Double x:Key="Height.DialogButton">28</sys:Double>
    <sys:Double x:Key="Height.Banner">48</sys:Double>
    <sys:Double x:Key="Height.BannerCollapsed">28</sys:Double>
    <sys:Double x:Key="Height.FilterBar">56</sys:Double>
    <sys:Double x:Key="Height.TreeRow">28</sys:Double>

    <!-- ===== Pane/control widths ===== -->
    <sys:Double x:Key="Width.Sidebar">220</sys:Double>
    <sys:Double x:Key="Width.SidebarCollapsed">48</sys:Double>
    <sys:Double x:Key="Width.TreePane">240</sys:Double>
    <sys:Double x:Key="Width.PreviewPane">300</sys:Double>
    <sys:Double x:Key="Width.SearchBox">220</sys:Double>
    <sys:Double x:Key="Width.DriveCard">192</sys:Double>
