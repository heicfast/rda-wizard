    <!-- ===== Icon sizes ===== -->
    <sys:Double x:Key="Icon.Size.S">16</sys:Double>
    <sys:Double x:Key="Icon.Size.M">20</sys:Double>
    <sys:Double x:Key="Icon.Size.L">24</sys:Double>
