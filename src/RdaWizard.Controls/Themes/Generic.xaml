<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:RdaWizard.Controls">

    <!-- ============ WizardStepper default template ============ -->
    <Style TargetType="{x:Type local:WizardStepper}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WizardStepper}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Step 1 -->
                        <StackPanel x:Name="step1" Orientation="Horizontal">
                            <Ellipse x:Name="dot1" Width="28" Height="28"
                                     Fill="{DynamicResource Brush.Bg.SurfaceAlt}"
                                     Stroke="{DynamicResource Brush.Border.Strong}"
                                     StrokeThickness="1.5" />
                            <TextBlock Text="{TemplateBinding Step1Text}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,16,0" />
                        </StackPanel>
                        <Rectangle x:Name="line1" Width="48" Height="2"
                                   Fill="{DynamicResource Brush.Border.Hairline}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                        <!-- Step 2 -->
                        <StackPanel x:Name="step2" Orientation="Horizontal">
                            <Ellipse x:Name="dot2" Width="28" Height="28"
                                     Fill="{DynamicResource Brush.Bg.SurfaceAlt}"
                                     Stroke="{DynamicResource Brush.Border.Strong}"
                                     StrokeThickness="1.5" />
                            <TextBlock Text="{TemplateBinding Step2Text}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,16,0" />
                        </StackPanel>
                        <Rectangle x:Name="line2" Width="48" Height="2"
                                   Fill="{DynamicResource Brush.Border.Hairline}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                        <!-- Step 3 -->
                        <StackPanel x:Name="step3" Orientation="Horizontal">
                            <Ellipse x:Name="dot3" Width="28" Height="28"
                                     Fill="{DynamicResource Brush.Bg.SurfaceAlt}"
                                     Stroke="{DynamicResource Brush.Border.Strong}"
                                     StrokeThickness="1.5" />
                            <TextBlock Text="{TemplateBinding Step3Text}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Step1State, RelativeSource={RelativeSource TemplatedParent}}" Value="Current">
                            <Setter TargetName="dot1" Property="Fill" Value="{DynamicResource Brush.Brand.Primary}" />
                            <Setter TargetName="dot1" Property="Stroke" Value="{DynamicResource Brush.Brand.Primary}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Step1State, RelativeSource={RelativeSource TemplatedParent}}" Value="Completed">
                            <Setter TargetName="dot1" Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                            <Setter TargetName="dot1" Property="Stroke" Value="{DynamicResource Brush.Status.Success}" />
                            <Setter TargetName="line1" Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Step2State, RelativeSource={RelativeSource TemplatedParent}}" Value="Current">
                            <Setter TargetName="dot2" Property="Fill" Value="{DynamicResource Brush.Brand.Primary}" />
                            <Setter TargetName="dot2" Property="Stroke" Value="{DynamicResource Brush.Brand.Primary}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Step2State, RelativeSource={RelativeSource TemplatedParent}}" Value="Completed">
                            <Setter TargetName="dot2" Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                            <Setter TargetName="dot2" Property="Stroke" Value="{DynamicResource Brush.Status.Success}" />
                            <Setter TargetName="line2" Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Step3State, RelativeSource={RelativeSource TemplatedParent}}" Value="Current">
                            <Setter TargetName="dot3" Property="Fill" Value="{DynamicResource Brush.Brand.Primary}" />
                            <Setter TargetName="dot3" Property="Stroke" Value="{DynamicResource Brush.Brand.Primary}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Step3State, RelativeSource={RelativeSource TemplatedParent}}" Value="Completed">
                            <Setter TargetName="dot3" Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                            <Setter TargetName="dot3" Property="Stroke" Value="{DynamicResource Brush.Status.Success}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ConfidenceBadge default template ============ -->
    <Style TargetType="{x:Type local:ConfidenceBadge}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ConfidenceBadge}">
                    <Border x:Name="badge"
                            Background="{DynamicResource Brush.Confidence.Unknown.Bg}"
                            CornerRadius="{DynamicResource Radius.Badge}"
                            Padding="8,2"
                            ToolTip="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}">
                        <TextBlock x:Name="label"
                                   Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="{DynamicResource Font.Size.Micro}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Confidence.Unknown.Fg}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Grade, RelativeSource={RelativeSource TemplatedParent}}" Value="1">
                            <Setter TargetName="badge" Property="Background" Value="{DynamicResource Brush.Confidence.Excellent.Bg}" />
                            <Setter TargetName="label" Property="Foreground" Value="{DynamicResource Brush.Confidence.Excellent.Fg}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Grade, RelativeSource={RelativeSource TemplatedParent}}" Value="2">
                            <Setter TargetName="badge" Property="Background" Value="{DynamicResource Brush.Confidence.Partial.Bg}" />
                            <Setter TargetName="label" Property="Foreground" Value="{DynamicResource Brush.Confidence.Partial.Fg}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Grade, RelativeSource={RelativeSource TemplatedParent}}" Value="3">
                            <Setter TargetName="badge" Property="Background" Value="{DynamicResource Brush.Confidence.Overwritten.Bg}" />
                            <Setter TargetName="label" Property="Foreground" Value="{DynamicResource Brush.Confidence.Overwritten.Fg}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Grade, RelativeSource={RelativeSource TemplatedParent}}" Value="4">
                            <Setter TargetName="badge" Property="Background" Value="{DynamicResource Brush.Confidence.MetadataOnly.Bg}" />
                            <Setter TargetName="label" Property="Foreground" Value="{DynamicResource Brush.Confidence.MetadataOnly.Fg}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ HealthGauge default template ============ -->
    <Style TargetType="{x:Type local:HealthGauge}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HealthGauge}">
                    <StackPanel>
                        <Border Background="{DynamicResource Brush.Bg.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Height="8">
                            <Border x:Name="fill"
                                    Background="{DynamicResource Brush.Health.Unknown}"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Width="{TemplateBinding Width}"
                                    HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock Text="{TemplateBinding Caption}"
                                   Style="{DynamicResource Text.Caption}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ StateSurface (empty/error) default template ============ -->
    <Style TargetType="{x:Type local:StateSurface}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:StateSurface}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="{DynamicResource Coaching.MaxWidth}">
                        <TextBlock x:Name="glyph"
                                   Text="{TemplateBinding Glyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="48"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{TemplateBinding Headline}"
                                   Style="{DynamicResource Text.Subtitle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="{TemplateBinding Detail}"
                                   Style="{DynamicResource Text.Caption}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />
                        <ContentPresenter Margin="0,20,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsError" Value="True">
                            <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Brush.Status.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==================== ToggleSwitch ==================== -->
    <Style TargetType="{x:Type local:ToggleSwitch}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToggleSwitch}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Track 40x20 r10; thumb 16 travels 20px; on = brand fill -->
                        <Grid>
                            <Border x:Name="track"
                                    Width="40" Height="20"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    VerticalAlignment="Center" />
                            <Ellipse x:Name="thumb"
                                     Width="16" Height="16"
                                     Fill="{DynamicResource Brush.Bg.Card}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="2,0,0,0" />
                        </Grid>
                        <TextBlock Text="{TemplateBinding Header}"
                                   FontFamily="{DynamicResource Font.Family.Body}"
                                   FontSize="{DynamicResource Font.Size.Body}"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Brush.Brand.Primary}" />
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Brush.Border.Glass}" />
                            <Setter TargetName="track" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Brush.Disabled.Fill}" />
                            <Setter TargetName="thumb" Property="Fill" Value="{DynamicResource Brush.Disabled.FillStrong}" />
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Banner (+SessionBanner inherits template via key) ==================== -->
    <Style TargetType="{x:Type local:Banner}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Banner}">
                    <Border Background="{DynamicResource Brush.Status.SuccessBg}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Hairline}"
                            BorderThickness="1"
                            MinHeight="48"
                            Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Severity accent bar -->
                            <Rectangle Grid.Column="0" Fill="{DynamicResource Brush.Status.Success}" />
                            <Border x:Name="severityBg" Grid.Column="0" />
                            <Path x:Name="glyph"
                                  Grid.Column="1"
                                  Data="M 0 0" StrokeThickness="0"
                                  Fill="{DynamicResource Brush.Status.Success}"
                                  Width="20" Height="20"
                                  VerticalAlignment="Center"
                                  Margin="12,0,8,0" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,8">
                                <TextBlock Text="{TemplateBinding Title}"
                                           Style="{DynamicResource Text.BodyStrong}" />
                                <TextBlock Text="{TemplateBinding Message}"
                                           Style="{DynamicResource Text.Caption}" />
                            </StackPanel>
                            <Button x:Name="PART_ActionButton"
                                    Grid.Column="3"
                                    Style="{DynamicResource Button.Link}"
                                    Content="{TemplateBinding ActionLabel}"
                                    VerticalAlignment="Center"
                                    Margin="12,0"
                                    Visibility="Visible" />
                            <Button x:Name="PART_DismissButton"
                                    Grid.Column="4"
                                    Style="{DynamicResource Button.Icon}"
                                    Content="✕"
                                    AutomationProperties.Name="Dismiss"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Visibility="Visible" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ActionLabel" Value="">
                            <Setter TargetName="PART_ActionButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsDismissible" Value="False">
                            <Setter TargetName="PART_DismissButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Info">
                            <Setter TargetName="glyph" Property="Fill" Value="{DynamicResource Brush.Status.Info}" />
                            <Setter Property="Background" Value="{DynamicResource Brush.Tint.T1}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hairline}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="glyph" Property="Fill" Value="{DynamicResource Brush.Status.WarningStrong}" />
                            <Setter Property="Background" Value="{DynamicResource Brush.Status.WarningBg}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Danger">
                            <Setter TargetName="glyph" Property="Fill" Value="{DynamicResource Brush.Status.Danger}" />
                            <Setter Property="Background" Value="{DynamicResource Brush.Status.DangerBg}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="glyph" Property="Fill" Value="{DynamicResource Brush.Status.SuccessText}" />
                            <Setter Property="Background" Value="{DynamicResource Brush.Status.SuccessBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Toast ==================== -->
    <Style TargetType="{x:Type local:Toast}">
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Toast}">
                    <Border Background="{DynamicResource Brush.Bg.Elevated}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            Padding="16,12"
                            Effect="{DynamicResource Effect.Elevation.Flyout}">
                        <StackPanel>
                            <DockPanel>
                                <Rectangle x:Name="severityDot"
                                           DockPanel.Dock="Left"
                                           Width="8" Height="8"
                                           Fill="{DynamicResource Brush.Status.Info}"
                                           VerticalAlignment="Center"
                                           RadiusX="4" RadiusY="4" />
                                <TextBlock Text="{TemplateBinding Title}"
                                           Style="{DynamicResource Text.BodyStrong}"
                                           Margin="8,0,0,0" />
                            </DockPanel>
                            <TextBlock Text="{TemplateBinding Message}"
                                       Style="{DynamicResource Text.Caption}"
                                       Margin="16,4,0,0" />
                            <Button x:Name="PART_ActionButton"
                                    Style="{DynamicResource Button.Link}"
                                    Content="{TemplateBinding ActionLabel}"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="severityDot" Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="severityDot" Property="Fill" Value="{DynamicResource Brush.Status.Warning}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Danger">
                            <Setter TargetName="severityDot" Property="Fill" Value="{DynamicResource Brush.Status.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Segmented ==================== -->
    <Style TargetType="{x:Type local:Segmented}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Segmented}">
                    <Border Background="{DynamicResource Brush.Bg.Surface}"
                            CornerRadius="{DynamicResource Radius.ControlL}"
                            Padding="2">
                        <WrapPanel x:Name="PART_Panel" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented item: pill radio; selected = brand fill + white text -->
    <Style x:Key="Segmented.ItemStyle" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Body}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bg"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="content"
                                          Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.BrandTint}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.Brand.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Brand.On}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== ProgressSurface ==================== -->
    <Style TargetType="{x:Type local:ProgressSurface}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ProgressSurface}">
                    <StackPanel>
                        <Grid x:Name="headerRow" Visibility="Collapsed">
                            <TextBlock Text="{TemplateBinding StageLabel}"
                                       Style="{DynamicResource Text.CaptionStrong}" />
                            <TextBlock Text="{TemplateBinding DetailText}"
                                       Style="{DynamicResource Text.Caption}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Height="{TemplateBinding Height}" VerticalAlignment="Center">
                            <Border x:Name="track"
                                    Background="{DynamicResource Brush.Bg.SurfaceAlt}"
                                    CornerRadius="3" />
                            <!-- Determinate fill (animated width; gradient per Brush.ProgressFill) -->
                            <Rectangle x:Name="PART_Fill"
                                       Width="0"
                                       Fill="{DynamicResource Brush.ProgressFill}"
                                       RadiusX="3" RadiusY="3"
                                       HorizontalAlignment="Left" />
                            <!-- Indeterminate shimmer band: 40% width, 1600ms loop -->
                            <Rectangle x:Name="shimmer"
                                       Width="40"
                                       Fill="{DynamicResource Brush.ProgressFill}"
                                       RadiusX="3" RadiusY="3"
                                       HorizontalAlignment="Left"
                                       Opacity="0.85"
                                       Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Fill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="shimmer" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="StageLabel" Value="">
                            <Setter TargetName="headerRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== CircularGauge (scan ring; 96px default) ==================== -->
    <Style TargetType="{x:Type local:CircularGauge}">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="96" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CircularGauge}">
                    <Grid>
                        <!-- Track ring (8px) -->
                        <local:Arc StartAngle="0" Sweep="359.9"
                                   Stroke="{DynamicResource Brush.Bg.SurfaceAlt}"
                                   StrokeThickness="8"
                                   SnapsToDevicePixels="False"
                                   IsHitTestVisible="False"
                                   Margin="6" />
                        <!-- Value arc -->
                        <local:Arc x:Name="PART_Arc"
                                   StartAngle="0" Sweep="0"
                                   Stroke="{DynamicResource Brush.GaugeArc}"
                                   StrokeThickness="8"
                                   StrokeStartLineCap="Round"
                                   StrokeEndLineCap="Round"
                                   SnapsToDevicePixels="False"
                                   IsHitTestVisible="False"
                                   Margin="6" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Label}"
                                       Style="{DynamicResource Text.Numeral}"
                                       FontSize="{DynamicResource Font.Size.Title}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding SubLabel}"
                                       Style="{DynamicResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPaused" Value="True">
                            <Setter TargetName="PART_Arc" Property="Stroke" Value="{DynamicResource Brush.Status.Warning}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== FileTypeFilterChip ==================== -->
    <Style TargetType="{x:Type local:FileTypeFilterChip}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Body}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FileTypeFilterChip}">
                    <Border x:Name="bg"
                            Background="{DynamicResource Brush.Bg.Surface}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.ControlL}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="glyph"
                                  Data="{TemplateBinding Glyph}"
                                  Fill="{DynamicResource Brush.Text.Secondary}"
                                  Width="16" Height="16"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  Stretch="Uniform" />
                            <TextBlock Text="{TemplateBinding Content}"
                                       VerticalAlignment="Center" />
                            <Border x:Name="countPill"
                                    Background="{DynamicResource Brush.Tint.T2}"
                                    CornerRadius="8"
                                    Padding="6,1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Count}"
                                           Style="{DynamicResource Text.Micro}"
                                           Typography.NumeralAlignment="Tabular" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.Tint.T1}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Brush.Border.Selected}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.BrandTintStrong}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Brush.Border.Selected}" />
                            <Setter TargetName="glyph" Property="Fill" Value="{DynamicResource Brush.Brand.Interaction}" />
                            <Setter TargetName="countPill" Property="Background" Value="{DynamicResource Brush.Tint.T4}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== DriveCard ==================== -->
    <Style TargetType="{x:Type local:DriveCard}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="{DynamicResource Width.DriveCard}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DriveCard}">
                    <Border x:Name="card"
                            Background="{DynamicResource Brush.Bg.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="16,12,16,12">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Grid>
                                        <Path Data="{TemplateBinding Glyph}"
                                              Fill="{DynamicResource Brush.Brand.Primary}"
                                              Width="32" Height="32"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center" />
                                        <!-- BitLocker lock overlay -->
                                        <Border x:Name="lockOverlay"
                                                Background="{DynamicResource Brush.Status.Warning}"
                                                CornerRadius="8"
                                                Width="16" Height="16"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Visibility="Collapsed">
                                            <Path Data="M 8 1 C 5 1 3 3.5 3 6 L 3 8 L 2 8 C 1.4 8 1 8.4 1 9 L 1 13 C 1 13.6 1.4 14 2 14 L 14 14 C 14.6 14 15 13.6 15 13 L 15 9 C 15 8.4 14.6 8 14 8 L 13 8 L 13 6 C 13 3.5 11 1 8 1 Z M 8 3 C 9.7 3 11 4.3 11 6 L 11 8 L 5 8 L 5 6 C 5 4.3 6.3 3 8 3 Z"
                                                      Fill="White"
                                                      Width="10" Height="10"
                                                      Stretch="Uniform" />
                                        </Border>
                                    </Grid>
                                    <!-- Selection checkmark (top-right) -->
                                    <Ellipse x:Name="checkCircle"
                                             Fill="{DynamicResource Brush.Brand.Primary}"
                                             Width="20" Height="20"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Visibility="Collapsed">
                                        <Ellipse.OpacityMask>
                                            <Path Data="M 5 10 L 8.5 13.5 L 15 5" Stroke="White" StrokeThickness="2" />
                                        </Ellipse.OpacityMask>
                                    </Ellipse>
                                </StackPanel>
                                <TextBlock Text="{TemplateBinding DriveName}"
                                           Style="{DynamicResource Text.BodyStrong}"
                                           Margin="0,10,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{TemplateBinding FileSystem}"
                                           Style="{DynamicResource Text.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                <!-- Capacity bar 156x4 r2 + text -->
                                <Grid Margin="0,8,0,4">
                                    <Border Background="{DynamicResource Brush.Tint.T2}"
                                            Height="4" CornerRadius="2" />
                                    <Border x:Name="usedBar"
                                            Background="{DynamicResource Brush.Brand.Primary}"
                                            Height="4" CornerRadius="2"
                                            HorizontalAlignment="Left"
                                            Width="0" />
                                </Grid>
                                <TextBlock Text="{TemplateBinding CapacityText}"
                                           Style="{DynamicResource Text.Caption}"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <!-- Badges row -->
                                <StackPanel x:Name="badges" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Border x:Name="osBadge" Style="{DynamicResource Badge.Tag}" Visibility="Collapsed">
                                        <TextBlock Text="OS" Style="{DynamicResource Text.Micro}" />
                                    </Border>
                                    <Border x:Name="usbBadge" Style="{DynamicResource Badge.Tag}" Visibility="Collapsed" Margin="4,0,0,0">
                                        <TextBlock Text="USB" Style="{DynamicResource Text.Micro}" />
                                    </Border>
                                    <Border x:Name="ssdBadge" Style="{DynamicResource Badge.Tag}" Visibility="Collapsed" Margin="4,0,0,0">
                                        <TextBlock Text="SSD" Style="{DynamicResource Text.Micro}" />
                                    </Border>
                                    <Border x:Name="trimChip"
                                            Background="{DynamicResource Brush.Status.WarningBg}"
                                            BorderBrush="{DynamicResource Brush.Status.WarningStrong}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="6,1"
                                            Visibility="Collapsed"
                                            Margin="4,0,0,0"
                                            AutomationProperties.Name="TRIM enabled, recovery chances reduced">
                                        <TextBlock Text="TRIM" Style="{DynamicResource Text.Micro}"
                                                   Foreground="{DynamicResource Brush.Status.WarningStrong}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="card" Property="Background" Value="{DynamicResource Brush.Bg.CardHover}" />
                            <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Brush.Border.Selected}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Brush.Border.Selected}" />
                            <Setter TargetName="card" Property="BorderThickness" Value="2" />
                            <Setter TargetName="card" Property="Background" Value="{DynamicResource Brush.Bg.CardHover}" />
                            <Setter TargetName="checkCircle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsLocked" Value="True">
                            <Setter TargetName="lockOverlay" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowOsBadge" Value="True">
                            <Setter TargetName="osBadge" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowUsbBadge" Value="True">
                            <Setter TargetName="usbBadge" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowSsdBadge" Value="True">
                            <Setter TargetName="ssdBadge" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowTrimChip" Value="True">
                            <Setter TargetName="trimChip" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Badge.Tag: small neutral tag pill used by drive-card badges -->
    <Style x:Key="Badge.Tag" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Tint.T2}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="6,1" />
    </Style>

    <!-- ==================== SearchField ==================== -->
    <Style TargetType="{x:Type local:SearchField}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Body}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Brand.Primary}" />
        <Setter Property="Height" Value="{DynamicResource Height.M}" />
        <Setter Property="Width" Value="{DynamicResource Width.SearchBox}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SearchField}">
                    <Border x:Name="border"
                            Background="{DynamicResource Brush.Bg.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="M 10 4 A 6 6 0 1 0 10 16 A 6 6 0 0 0 10 4 M 14.5 14.5 L 20 20"
                                      Stroke="{DynamicResource Brush.Text.Tertiary}"
                                      StrokeThickness="1.5"
                                      Width="16" Height="16"
                                      Margin="8,0,6,0"
                                  VerticalAlignment="Center" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1"
                                          Margin="0,0,4,0"
                                          VerticalAlignment="Center"
                                          Focusable="False" />
                            <!-- Placeholder -->
                            <TextBlock x:Name="placeholder"
                                       Grid.Column="1"
                                       Text="{TemplateBinding Placeholder}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <Button x:Name="PART_ClearButton"
                                    Grid.Column="2"
                                    Style="{DynamicResource Button.Icon}"
                                    Width="24" Height="24"
                                    Margin="2,0,4,0"
                                    Content="✕"
                                    AutomationProperties.Name="Clear search"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasText" Value="False">
                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasText" Value="True">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                            <Setter TargetName="border" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Disabled.Fill}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Breadcrumb ==================== -->
    <Style TargetType="{x:Type local:Breadcrumb}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{DynamicResource Button.Link}"
                                Content="{Binding}" />
                        <TextBlock Text="›"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   Margin="6,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== RecoveryQueueRow ==================== -->
    <Style TargetType="{x:Type local:RecoveryQueueRow}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RecoveryQueueRow}">
                    <Border x:Name="row"
                            Background="{DynamicResource Brush.Bg.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Hairline}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="16" Height="16"
                                         Stroke="{DynamicResource Brush.Border.Strong}"
                                         StrokeThickness="1"
                                         VerticalAlignment="Center" />
                                <Ellipse x:Name="radioFill"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource Brush.Brand.Primary}"
                                         Margin="-12,0,0,0"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Visibility="Collapsed" />
                                <Path Data="{TemplateBinding Glyph}"
                                      Fill="{DynamicResource Brush.Brand.Primary}"
                                      Width="24" Height="24"
                                      Stretch="Uniform"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding DestinationName}"
                                           Style="{DynamicResource Text.BodyStrong}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{TemplateBinding CapacityText}"
                                           Style="{DynamicResource Text.Caption}"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </StackPanel>
                            <!-- Fit verdict chip -->
                            <Border x:Name="verdict"
                                    Grid.Column="2"
                                    Background="{DynamicResource Brush.Status.SuccessBg}"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding VerdictText}"
                                           Style="{DynamicResource Text.Micro}"
                                           Foreground="{DynamicResource Brush.Status.SuccessText}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource Brush.Border.Selected}" />
                            <Setter TargetName="row" Property="BorderThickness" Value="2" />
                            <Setter TargetName="radioFill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource Brush.Bg.CardHover}" />
                        </Trigger>
                        <Trigger Property="VerdictKind" Value="1">
                            <Setter TargetName="verdict" Property="Background" Value="{DynamicResource Brush.Status.WarningBg}" />
                            <Setter TargetName="verdict" Property="BorderBrush" Value="{DynamicResource Brush.Status.WarningStrong}" />
                            <Setter TargetName="verdict" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="VerdictKind" Value="2">
                            <Setter TargetName="verdict" Property="Background" Value="{DynamicResource Brush.Status.DangerBg}" />
                            <Setter TargetName="verdict" Property="BorderBrush" Value="{DynamicResource Brush.Status.Danger}" />
                            <Setter TargetName="verdict" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== SessionBanner (Banner + session stat strip) ==================== -->
    <Style TargetType="{x:Type local:SessionBanner}" BasedOn="{StaticResource {x:Type local:Banner}}">
        <Setter Property="Severity" Value="Info" />
        <Setter Property="ActionLabel" Value="Load session" />
    </Style>


    <!-- ==================== Icon ==================== -->
    <Style TargetType="{x:Type local:Icon}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Icon}">
                    <Viewbox Stretch="Uniform"
                             SnapsToDevicePixels="True"
                             Width="{TemplateBinding IconSize}"
                             Height="{TemplateBinding IconSize}">
                        <Path x:Name="PART_Path"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform" />
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
