<UserControl x:Class="RdaWizard.App.DesignSpecs.CompactSpecs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RdaWizard.Controls;assembly=RdaWizard.Controls"
             Tag="DESIGN SPEC — compact surfaces: Splash (P00), ScanConfig modes, Completion (P08a), Health (P31). Static data.">
    <ScrollViewer Padding="{DynamicResource Space.Page}">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <!-- ===== P00 Splash (420×280 card, r20, hero gradient, logo 80, progress hairline) ===== -->
            <TextBlock Text="P00 — Splash (420×280, r20)" Style="{DynamicResource Section.Header}" />
            <Border CornerRadius="{DynamicResource Radius.Splash}" Width="420" Height="280"
                    Background="{DynamicResource Brush.WindowHero}"
                    BorderBrush="{DynamicResource Brush.Border.Hairline}" BorderThickness="1"
                    Effect="{DynamicResource Effect.Elevation.Dialog}"
                    ClipToBounds="True">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:Icon IconName="Icon.Action.About" IconKind="Solid" IconSize="80"
                                       IconBrush="{DynamicResource Brush.Brand.Primary}" HorizontalAlignment="Center" />
                        <TextBlock Text="RDA Data Recovery Wizard" Style="{DynamicResource Text.Header}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="Reading the disk information, please wait..."
                                   Style="{DynamicResource Text.Caption}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,8,0,0" />
                    </StackPanel>
                    <!-- Bottom-edge hairline progress (~60-70% filled during enumeration) -->
                    <StackPanel VerticalAlignment="Bottom">
                        <Grid Height="4">
                            <Border Background="{DynamicResource Brush.Tint.T2}" />
                            <Border Background="{DynamicResource Brush.ProgressFill}" Width="260" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Scan modes (P06 entry; radio cards 3-up) ===== -->
            <TextBlock Text="Scan mode selector (radio cards)" Style="{DynamicResource Section.Header}" Margin="0,24,0,0" />
            <UniformGrid Columns="3">
                <Border Style="{DynamicResource Card.Selected}" Margin="6" Padding="16">
                    <StackPanel>
                        <RadioButton GroupName="specmode" IsChecked="True" Content="Quick Scan" Style="{DynamicResource Text.BodyStrong}" />
                        <controls:Icon IconName="Icon.Art.Scanning" IconKind="Art" IconSize="48" IconBrush="{DynamicResource Brush.Brand.Primary}" Margin="0,8" />
                        <TextBlock Text="Fast pass over the file table. Finds recently deleted files." Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Margin="6" Padding="16">
                    <StackPanel>
                        <RadioButton GroupName="specmode" Content="Deep Scan" Style="{DynamicResource Text.BodyStrong}" />
                        <controls:Icon IconName="Icon.Device.Disk" IconKind="Solid" IconSize="48" IconBrush="{DynamicResource Brush.Text.Tertiary}" Margin="0,8" />
                        <TextBlock Text="Sector-by-sector pass. Finds formatted and long-lost files." Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Margin="6" Padding="16">
                    <StackPanel>
                        <RadioButton GroupName="specmode" Content="Specify file types" Style="{DynamicResource Text.BodyStrong}" />
                        <controls:Icon IconName="Icon.Action.Filter" IconSize="48" Margin="0,8" />
                        <TextBlock Text="Scan for selected formats only (photos, video, documents...)." Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===== P08a Celebration (540×380, r20; stats grid 2×4; CTA at (0.48,0.66)) ===== -->
            <TextBlock Text="P08a — Scan-complete celebration (540×380)" Style="{DynamicResource Section.Header}" Margin="0,24,0,0" />
            <Border CornerRadius="{DynamicResource Radius.Splash}" Width="540" Height="380"
                    Background="{DynamicResource Brush.Bg.Window}"
                    BorderBrush="{DynamicResource Brush.Border.Hairline}" BorderThickness="1"
                    Effect="{DynamicResource Effect.Elevation.Dialog}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                    <controls:Icon IconName="Icon.Art.ScanComplete" IconKind="Art" IconSize="72"
                                   IconBrush="{DynamicResource Brush.Health.Good}" HorizontalAlignment="Center" />
                    <TextBlock Text="Congratulations! Scan Completed!" Style="{DynamicResource Text.Header}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <UniformGrid Columns="2" Margin="0,20,0,0">
                        <Border Style="{DynamicResource Panel}" Margin="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Files found" Style="{DynamicResource Text.Caption}" />
                                <TextBlock Text="1,139,261" Style="{DynamicResource Text.Title}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Panel}" Margin="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Total size" Style="{DynamicResource Text.Caption}" />
                                <TextBlock Text="147.04 GB" Style="{DynamicResource Text.Title}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Panel}" Margin="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Used time" Style="{DynamicResource Text.Caption}" />
                                <TextBlock Text="00:02:38" Style="{DynamicResource Text.Title}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Panel}" Margin="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Organized" Style="{DynamicResource Text.Caption}" />
                                <TextBlock Text="100%" Style="{DynamicResource Text.Title}" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Button Style="{DynamicResource Button.Hero}" Content="Go to Recover"
                            HorizontalAlignment="Center" Margin="0,24,0,0" MinWidth="200" />
                </StackPanel>
            </Border>

            <!-- ===== P31 Health (gauge + SMART shell) ===== -->
            <TextBlock Text="P31 — Disk health (gauge + SMART table)" Style="{DynamicResource Section.Header}" Margin="0,24,0,0" />
            <Border Style="{DynamicResource Card}" Margin="0,8,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <controls:HealthGauge Band="1" Caption="Caution" />
                        <StackPanel VerticalAlignment="Center" Margin="24,0,0,0">
                            <TextBlock Text="WDC WDS150G1B0A" Style="{DynamicResource Text.BodyStrong}" />
                            <TextBlock Text="148.9 GB · SATA SSD · 31°C" Style="{DynamicResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" Typography.NumeralAlignment="Tabular" />
                            <Button Style="{DynamicResource Button.Link}" Content="View solutions" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <ListView Background="Transparent" BorderThickness="0" Margin="0,16,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" Width="40" />
                                <GridViewColumn Header="Attribute" Width="220" />
                                <GridViewColumn Header="Current" Width="80" />
                                <GridViewColumn Header="Worst" Width="80" />
                                <GridViewColumn Header="Threshold" Width="90" />
                                <GridViewColumn Header="Status" Width="90" />
                            </GridView>
                        </ListView.View>
                        <ListViewItem>
                            <TextBlock Text=" 05   Reallocated Sectors Count        100   100   10      OK" />
                        </ListViewItem>
                        <ListViewItem>
                            <TextBlock Text=" C4   Reallocation Event Count         100   100   0       OK" />
                        </ListViewItem>
                        <ListViewItem>
                            <TextBlock Text=" B1   Wear Leveling Count               97    97    5       Caution" Foreground="{DynamicResource Brush.Status.WarningStrong}" />
                        </ListViewItem>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
