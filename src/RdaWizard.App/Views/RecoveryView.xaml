<UserControl x:Class="RdaWizard.App.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RdaWizard.Controls;assembly=RdaWizard.Controls"
             xmlns:app="clr-namespace:RdaWizard.App"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <app:Converters.BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <app:Converters.CountToVisibilityConverter x:Key="CountToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Style="{DynamicResource Text.Title}" Text="Where should the files go?" />
            <TextBlock Style="{DynamicResource Text.BodySecondary}"
                       Text="Choose a destination on a DIFFERENT disk than the one you are recovering from — writing onto the source would destroy recoverable data."
                       MaxWidth="{DynamicResource Coaching.MaxWidth}"
                       Margin="0,8,0,0" />
        </StackPanel>

        <!-- Setup surface (before recovery starts) -->
        <StackPanel Grid.Row="1"
                    MaxWidth="{DynamicResource Content.MaxWidth}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Visibility="{Binding IsRecovering, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">

            <TextBlock Style="{DynamicResource Text.Subtitle}" Text="Destination" Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         IsReadOnly="True"
                         Text="{Binding DestinationDirectory, TargetNullValue=Click choose…}"
                         AutomationProperties.Name="Recovery destination folder" />
                <Button Grid.Column="1"
                        Content="Browse…"
                        Margin="8,0,0,0"
                        Click="OnBrowseDestinationClick" />
            </Grid>

            <!-- Options -->
            <TextBlock Style="{DynamicResource Text.Subtitle}" Text="Options" Margin="0,24,0,8" />
            <CheckBox Content="Rebuild the original folder structure"
                      IsChecked="{Binding PreserveFolderStructure}"
                      Margin="0,0,0,8"
                      ToolTip="Destination mirrors the scanned folder tree (the engine writes files; folders are pre-created by the wizard)" />
            <TextBlock Style="{DynamicResource Text.Caption}"
                       Text="Name collisions are always renamed (name (2).ext) — files are never silently overwritten. Empty folders cannot be reconstructed (engine limitation, tracked)."
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <!-- Preflight refusals (hard gate) -->
            <Border Padding="12"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Background="{DynamicResource Brush.Status.DangerBg}"
                    BorderBrush="{DynamicResource Brush.Border.Danger}"
                    BorderThickness="1"
                    Visibility="{Binding PreflightRefusals.Count, Converter={StaticResource CountToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Body}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Status.DangerText}"
                               Text="Recovery to this destination is refused:" />
                    <ItemsControl ItemsSource="{Binding PreflightRefusals}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{DynamicResource Text.Caption}"
                                           Foreground="{DynamicResource Brush.Status.DangerText}"
                                           Text="{Binding}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Running surface -->
        <StackPanel Grid.Row="1"
                    Visibility="{Binding IsRecovering, Converter={StaticResource BoolToVisibility}}"
                    MaxWidth="{DynamicResource Content.MaxWidth}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
            <TextBlock Style="{DynamicResource Text.Subtitle}" Text="Recovering your files…" Margin="0,0,0,16" />
            <ProgressBar Style="{DynamicResource ProgressBar.Hero}"
                         Minimum="0" Maximum="100"
                         Value="{Binding Percent, Mode=OneWay}" />
            <UniformGrid Columns="2" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Text="FILES WRITTEN" />
                    <TextBlock Style="{DynamicResource Text.Body}"
                               FontFamily="{DynamicResource Font.Family.Mono}"
                               FontWeight="SemiBold"
                               Text="{Binding FilesDone}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Text="ELAPSED" />
                    <TextBlock Style="{DynamicResource Text.Body}"
                               FontFamily="{DynamicResource Font.Family.Mono}"
                               FontWeight="SemiBold"
                               Text="{Binding ElapsedText}" />
                </StackPanel>
            </UniformGrid>
            <TextBlock Style="{DynamicResource Text.Caption}"
                       Text="Files are hash-verified as they are written where the engine stored a hash (carved files)."
                       TextWrapping="Wrap"
                       Margin="0,16,0,0" />
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="16"
                CornerRadius="{DynamicResource Radius.Card}"
                Background="{DynamicResource Brush.Bg.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{DynamicResource Text.BodySecondary}"
                           VerticalAlignment="Center"
                           Text="{Binding FailureDiagnostic, TargetNullValue='Run the destination check, then start the recovery.'}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel"
                            Height="{DynamicResource Height.XS}"
                            Padding="12,4"
                            Margin="0,0,8,0"
                            Click="OnCancelRecoveryClick"
                            Visibility="{Binding IsRecovering, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{DynamicResource Button.Primary}"
                            Content="Recover now"
                            Click="OnStartRecoveryClick"
                            IsEnabled="{Binding IsRecovering, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
