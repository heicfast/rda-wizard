<UserControl x:Class="RdaWizard.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RdaWizard.Controls;assembly=RdaWizard.Controls"
             xmlns:app="clr-namespace:RdaWizard.App"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <app:Converters.ByteSizeConverter x:Key="ByteSize" />
        <app:Converters.BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <app:Converters.NullToVisibilityConverter x:Key="NullToVisibility" />
        <app:Converters.EnumToIntConverter x:Key="EnumToInt" />
        <app:Converters.NullableDateConverter x:Key="NullableDate" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Filter bar ===== -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="12"
                CornerRadius="{DynamicResource Radius.Control}"
                Background="{DynamicResource Brush.Bg.SearchStrip}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Style="{DynamicResource TextBox.Search}"
                         MaxWidth="480"
                         HorizontalAlignment="Left"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search files by name"
                         ToolTip="Search by name (applies instantly)" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Select all"
                            Height="{DynamicResource Height.XS}"
                            Padding="12,4"
                            Margin="0,0,8,0"
                            Command="{Binding SelectAllVisibleCommand}" />
                    <Button Content="Invert"
                            Height="{DynamicResource Height.XS}"
                            Padding="12,4"
                            Margin="0,0,8,0"
                            Command="{Binding InvertSelectionCommand}" />
                    <Button Content="Clear"
                            Height="{DynamicResource Height.XS}"
                            Padding="12,4"
                            Command="{Binding ClearSelectionCommand}" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0">
                    <Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" selected · " />
                    <Run Text="{Binding VisibleFileCount, Mode=OneWay}" /><Run Text=" of " />
                    <Run Text="{Binding TotalFileCount, Mode=OneWay}" /><Run Text=" files" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- ===== Empty state (no session) ===== -->
        <controls:StateSurface Grid.Row="1"
                               Visibility="{Binding Session, Converter={StaticResource NullToVisibility}}"
                               Glyph="&#xE8CB;"
                               Headline="No results loaded"
                               Detail="Complete a scan or open a saved session from the home page." />

        <!-- ===== Recover footer (only when a session is loaded) ===== -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="12,8"
                CornerRadius="{DynamicResource Radius.Control}"
                Background="{DynamicResource Brush.Bg.Card}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="1"
                HorizontalAlignment="Right"
                Visibility="{Binding Session, Converter={StaticResource NullToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Save session copy…"
                        Height="{DynamicResource Height.XS}"
                        Padding="12,4"
                        Margin="0,0,8,0"
                        Command="{Binding SaveSessionCopyCommand}" />
                <Button Style="{DynamicResource Button.Primary}"
                        Content="Recover selected files"
                        Click="OnRecoverClick"
                        ToolTip="{Binding SelectedCount, StringFormat={}{0} files selected}" />
            </StackPanel>
        </Border>

        <!-- ===== Main 2-pane explorer ===== -->
        <Grid Grid.Row="1"
              Visibility="{Binding Session, Converter={StaticResource NullToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: path tree (root entries) + raw groupings -->
            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Padding="8"
                    CornerRadius="{DynamicResource Radius.Card}"
                    Background="{DynamicResource Brush.Bg.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Hairline}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Style="{DynamicResource Text.CaptionStrong}"
                               Text="FILE PATH"
                               Margin="4,4,0,8" />
                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding TreeRoots}"
                              VirtualizingPanel.IsVirtualizing="True">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Node.IsDirectory, Mode=OneWay}" Visibility="Collapsed" />
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <!-- Raw/lost groupings (og parity: bottom of tree) -->
                    <StackPanel Grid.Row="2" Margin="4,12,4,4">
                        <TextBlock Style="{DynamicResource Text.CaptionStrong}" Text="RAW FOUND" />
                        <TextBlock Style="{DynamicResource Text.Caption}"
                                   Text="{Binding Session.CarvedNodes.Count, Mode=OneWay, StringFormat='{}{0} carved files (signature search)'}" />
                        <TextBlock Style="{DynamicResource Text.CaptionStrong}"
                                   Text="LOST PARTITIONS"
                                   Margin="0,8,0,0" />
                        <TextBlock Style="{DynamicResource Text.Caption}"
                                   Text="{Binding Session.LostNodes.Count, Mode=OneWay, StringFormat='{}{0} files from lost partitions'}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: virtualized detail list -->
            <Border Grid.Column="1"
                    CornerRadius="{DynamicResource Radius.Card}"
                    Background="{DynamicResource Brush.Bg.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Hairline}"
                    BorderThickness="1">
                <ListView ItemsSource="{Binding VisibleFiles}"
                          SelectionMode="Extended"
                          SelectionChanged="OnSelectionChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          AutomationProperties.Name="Scan results file list">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="280">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <controls:ConfidenceBadge Grade="{Binding Confidence, Converter={StaticResource EnumToInt}}"
                                                                      Margin="0,0,8,0"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       ToolTip="{Binding FullPath}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Path" Width="240">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ParentPath, TargetNullValue=—}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   ToolTip="{Binding FullPath}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LogicalSize, Converter={StaticResource ByteSize}}"
                                                   HorizontalAlignment="Right"
                                                   FontFamily="{DynamicResource Font.Family.Mono}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Modified" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Timestamp, Converter={StaticResource NullableDate}}"
                                                   ToolTip="The engine's tree projection carries no timestamps yet (tracked core gap)" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="State" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DeletedState}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</UserControl>
