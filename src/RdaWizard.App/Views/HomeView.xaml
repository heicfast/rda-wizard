<UserControl x:Class="RdaWizard.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RdaWizard.Controls;assembly=RdaWizard.Controls"
             xmlns:conv="clr-namespace:RdaWizard.App.Converters"
             xmlns:models="clr-namespace:RdaWizard.Core.Models;assembly=RdaWizard.Core"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:ByteSizeConverter x:Key="ByteSize" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Style="{DynamicResource Text.Title}"
                       Text="Where did you lose your files?" />
            <TextBlock Style="{DynamicResource Text.BodySecondary}"
                       Text="Pick the disk or drive where the data was lost. Lost files, deleted partitions and formatted drives are all recoverable from here."
                       MaxWidth="{DynamicResource Coaching.MaxWidth}"
                       Margin="0,8,0,0" />
        </StackPanel>

        <!-- ===== Loading state ===== -->
        <controls:StateSurface Grid.Row="1"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                               Glyph="&#xE945;"
                               Headline="Reading the disk information…"
                               Detail="The engine is enumerating disks and volumes. This usually takes a few seconds." />

        <!-- ===== Error state ===== -->
        <controls:StateSurface Grid.Row="1"
                               Visibility="{Binding ErrorDiagnostic, Converter={StaticResource NullToVisibility}}"
                               IsError="True"
                               Glyph="&#xE7BA;"
                               Headline="The disk list could not be read"
                               Detail="{Binding ErrorDiagnostic}">
            <controls:StateSurface.Content>
                <Button Content="Try again"
                        Style="{DynamicResource Button.Primary}"
                        Command="{Binding RefreshCommand}" />
            </controls:StateSurface.Content>
        </controls:StateSurface>

        <!-- ===== Main split: device list + session import ===== -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DiskInfo}">
                            <!-- DriveCard: whole-disk target -->
                            <Border Margin="0,0,0,12"
                                    Padding="16"
                                    CornerRadius="{DynamicResource Radius.Card}"
                                    Background="{DynamicResource Brush.Bg.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.SelectDiskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Grid.InputBindings>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="&#xE7DA;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="28"
                                               Foreground="{DynamicResource Brush.Brand.Primary}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{DynamicResource Text.Body}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Style="{DynamicResource Text.Caption}"
                                                       Text="{Binding SizeBytes, Converter={StaticResource ByteSize}}" />
                                            <TextBlock Style="{DynamicResource Text.Caption}"
                                                       Margin="8,0,0,0"
                                                       Text="{Binding Table}" />
                                            <TextBlock Style="{DynamicResource Text.Caption}"
                                                       Margin="8,0,0,0"
                                                       Text="{Binding Serial}" />
                                        </StackPanel>
                                        <!-- Volumes (nested) -->
                                        <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:VolumeInfo}">
                                                    <Border Margin="0,0,0,6,0"
                                                            Padding="10,6"
                                                            CornerRadius="{DynamicResource Radius.Control}"
                                                            Background="{DynamicResource Brush.Bg.Surface}"
                                                            BorderBrush="{DynamicResource Brush.Border.Hairline}"
                                                            BorderThickness="1"
                                                            Cursor="Hand">
                                                        <Grid>
                                                            <Grid.InputBindings>
                                                                <MouseBinding Gesture="LeftClick"
                                                                              Command="{Binding DataContext.SelectVolumeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              CommandParameter="{Binding}" />
                                                            </Grid.InputBindings>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="&#xEDA2;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="16"
                                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="1"
                                                                       Style="{DynamicResource Text.Body}"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding DisplayName}" />
                                                            <TextBlock Grid.Column="2"
                                                                       Style="{DynamicResource Text.Caption}"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding SizeBytes, Converter={StaticResource ByteSize}}"
                                                                       Margin="12,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <controls:HealthGauge Grid.Column="2"
                                                          Width="80"
                                                          Band="3"
                                                          VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ===== Footer: selected target + session import + CTA ===== -->
            <Border Grid.Row="1"
                    Margin="0,16,0,0"
                    Padding="16"
                    CornerRadius="{DynamicResource Radius.Card}"
                    Background="{DynamicResource Brush.Bg.Window}"
                    BorderBrush="{DynamicResource Brush.Border.Hairline}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Text.Caption}"
                                   Text="SELECTED" />
                        <TextBlock Style="{DynamicResource Text.Body}"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedTarget.Description, TargetNullValue=Nothing selected yet — pick a disk or drive above}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Open saved scan session…"
                                    Height="{DynamicResource Height.XS}"
                                    Padding="12,4"
                                    Margin="0,0,8,0"
                                    Command="{Binding ImportSessionFileCommand}" />
                            <TextBlock Style="{DynamicResource Text.Caption}"
                                       VerticalAlignment="Center"
                                       Text="{Binding Driver.TransportLabel, TargetNullValue=Checking driver…}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{DynamicResource Button.Hero}"
                            VerticalAlignment="Center"
                            Click="OnBeginScanClick"
                            Content="Search for lost data" />
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Recent sessions (compact strip, only when present) ===== -->
    </Grid>
</UserControl>
