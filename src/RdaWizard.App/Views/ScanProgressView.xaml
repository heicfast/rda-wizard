<UserControl x:Class="RdaWizard.App.Views.ScanProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RdaWizard.Controls;assembly=RdaWizard.Controls"
             xmlns:app="clr-namespace:RdaWizard.App"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <app:Converters.BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <app:Converters.ByteSizeConverter x:Key="ByteSize" />
        <app:Converters.CountToVisibilityConverter x:Key="CountToVisibility" />
        <app:Converters.NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Style="{DynamicResource Text.Title}"
                       Text="Scanning for your files…" />
            <TextBlock Style="{DynamicResource Text.BodySecondary}"
                       Text="Keep the disk connected. You can keep using your computer — the scan runs in the engine and does not modify the source disk."
                       MaxWidth="{DynamicResource Coaching.MaxWidth}"
                       Margin="0,8,0,0" />
        </StackPanel>

        <!-- ===== Running surface ===== -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
              VerticalAlignment="Top"
              MaxWidth="{DynamicResource Content.MaxWidth}"
              HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero progress -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Style="{DynamicResource ProgressBar.Hero}"
                             Minimum="0" Maximum="100"
                             Value="{Binding Percent, Mode=OneWay}" />
                <TextBlock Grid.Column="1"
                           Style="{DynamicResource Text.Subtitle}"
                           FontFamily="{DynamicResource Font.Family.Mono}"
                           Text="{Binding Percent, StringFormat={}{0:0.0}%}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Stats row -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Text="ELAPSED" />
                    <TextBlock Style="{DynamicResource Text.Body}"
                               FontFamily="{DynamicResource Font.Family.Mono}"
                               FontWeight="SemiBold"
                               Text="{Binding ElapsedText}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Text="ESTIMATED REMAINING" />
                    <TextBlock Style="{DynamicResource Text.Body}"
                               FontFamily="{DynamicResource Font.Family.Mono}"
                               FontWeight="SemiBold"
                               Text="{Binding EtaText, TargetNullValue=—}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Text="READ ERRORS" />
                    <TextBlock Style="{DynamicResource Text.Body}"
                               FontFamily="{DynamicResource Font.Family.Mono}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Status.WarningStrong}"
                               Text="{Binding ReadErrorCount}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Text="UNREADABLE DATA" />
                    <TextBlock Style="{DynamicResource Text.Body}"
                               FontFamily="{DynamicResource Font.Family.Mono}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Status.WarningStrong}"
                               Text="{Binding ReadErrorBytes, Converter={StaticResource ByteSize}}" />
                </StackPanel>
            </UniformGrid>

            <!-- Transport truth -->
            <Border Grid.Row="2"
                    Margin="0,24,0,0"
                    Padding="12"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Background="{DynamicResource Brush.Bg.SearchStrip}">
                <TextBlock Style="{DynamicResource Text.Caption}"
                           Text="{Binding TransportLabel, TargetNullValue=Transport: resolved when the engine starts reading.}" />
            </Border>

            <!-- Read-error ranges (live, from the stage log) -->
            <Border Grid.Row="3"
                    Margin="0,12,0,0"
                    Padding="12"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Background="{DynamicResource Brush.Bg.Surface}"
                    Visibility="{Binding ReadErrorCount, Converter={StaticResource CountToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.CaptionStrong}" Text="Damaged areas the engine retried:" />
                    <ItemsControl ItemsSource="{Binding ReadErrors}" MaxHeight="160">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{DynamicResource Text.CaptionMono}"
                                           Margin="0,2,0,0">
                                    <Run Text="@offset " /><Run Text="{Binding OffsetBytes, Mode=OneWay}" />
                                    <Run Text="  +len " /><Run Text="{Binding LengthBytes, Mode=OneWay}" />
                                    <Run Text="  attempts " /><Run Text="{Binding Attempts, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- No pause by design (G-07 truth); cancel is destructive-with-confirmation -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,24,0,0">
                <Button Style="{DynamicResource Button.Primary}"
                        Content="Cancel scan"
                        Click="OnCancelScanClick"
                        ToolTip="The engine cannot save partial results — everything found so far in this scan is lost." />
                <TextBlock Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           MaxWidth="420"
                           Text="Pausing is not available: the engine has no save-mid-scan. Cancelling discards what this run has found so far."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- ===== Failure surface ===== -->
        <controls:StateSurface Grid.Row="1"
                               Visibility="{Binding FailureDiagnostic, Converter={StaticResource NullToVisibility}}"
                               IsError="True"
                               Glyph="&#xE7BA;"
                               Headline="The scan stopped"
                               Detail="{Binding FailureDiagnostic}" />

        <!-- ===== Completion teaser (summary present) ===== -->
        <controls:StateSurface Grid.Row="1"
                               Visibility="{Binding Summary, Converter={StaticResource NullToVisibility}}"
                               Glyph="&#xE8FB;"
                               Headline="Scan finished — preparing results…"
                               Detail="The session was saved. The results explorer opens next." />
    </Grid>
</UserControl>
