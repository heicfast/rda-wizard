<UserControl x:Class="RdaWizard.App.Views.LostPartitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="900">

    <!-- og PG-23 (screenshot: 02-landing/landing-sidebar-lostpartition-page.png):
         3 scenario cards + hard-drive graphic + blue Start CTA. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28,40,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Style="{DynamicResource Text.Title}" Text="Lost Partition Rescue" />
            <TextBlock Style="{DynamicResource Text.BodySecondary}"
                       Margin="0,6,0,0"
                       Text="{Binding Subtitle}" />

            <ItemsControl ItemsSource="{Binding Scenarios}" Margin="0,24,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16"
                                Margin="0,0,0,12"
                                CornerRadius="{DynamicResource Radius.Card}"
                                Background="{DynamicResource Brush.Bg.Card}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="{Binding Title}" />
                                <TextBlock Style="{DynamicResource Text.Caption}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Text="{Binding Description}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{DynamicResource Button.Primary}"
                    Content="Start"
                    MinWidth="140"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    Command="{Binding StartCommand}" />

            <TextBlock Style="{DynamicResource Text.Caption}"
                       Margin="0,16,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Text="Scanning a whole disk finds lost partitions: they appear in the results tree so their files can be recovered." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
