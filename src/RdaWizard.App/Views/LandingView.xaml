<UserControl x:Class="RdaWizard.App.Views.LandingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RdaWizard.Controls;assembly=RdaWizard.Controls"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="900">

    <!-- TRANSITIONAL: device list + CTA. The full og landing (tiles with
         capacity bars, "Specify a location" trio, session banner, can't-find
         link) lands in the landing-page phase. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
        <conv:ByteSizeConverter x:Key="ByteSize" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
    </UserControl.Resources>

    <Grid Margin="40,28,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page title (og: "Select a location to search for lost data") -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{DynamicResource Text.Display}" Text="Select a location to search for lost data" />
        </StackPanel>

        <!-- Loading / error / device list -->
        <Grid Grid.Row="1">
            <controls:StateSurface Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                   Headline="Reading the disk information…"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

            <Border Visibility="{Binding ErrorDiagnostic, Converter={StaticResource NullToVisibility}}"
                    Padding="16"
                    CornerRadius="{DynamicResource Radius.Card}"
                    Background="{DynamicResource Brush.Status.WarningBg}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.BodyStrong}"
                               Foreground="{DynamicResource Brush.Status.WarningText}"
                               Text="{Binding ErrorDiagnostic}"
                               TextWrapping="Wrap" />
                    <Button Style="{DynamicResource Button.Secondary}"
                            Content="Try again"
                            Margin="0,12,0,0"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12"
                                    Padding="16"
                                    CornerRadius="{DynamicResource Radius.Card}"
                                    Background="{DynamicResource Brush.Bg.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    MouseLeftButtonUp="OnDiskCardClick"
                                    Tag="{Binding}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="{Binding DisplayName}" />
                                        <TextBlock Style="{DynamicResource Text.BodySecondary}"
                                                   Margin="12,0,0,0"
                                                   Text="{Binding SizeBytes, Converter={StaticResource ByteSize}}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{DynamicResource Button.Ghost}"
                                                        HorizontalContentAlignment="Left"
                                                        Margin="0,2"
                                                        Content="{Binding DisplayName}"
                                                        Click="OnVolumeRowClick"
                                                        Tag="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Session resume banner (P41) + CTA row -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Border Visibility="{Binding RecentSessions.Count, Converter={StaticResource CountToVisibility}}"
                    Padding="12,8"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Background="{DynamicResource Brush.Bg.SearchStrip}"
                    Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="Continue last scanning" />
                    <Button Style="{DynamicResource Button.Link}"
                            Content="Load"
                            Margin="12,0,0,0"
                            Command="{Binding LoadSessionCommand}"
                            CommandParameter="{Binding RecentSessions[0]}" />
                    <Button Style="{DynamicResource Button.Link}"
                            Content="Open another session…"
                            Margin="12,0,0,0"
                            Command="{Binding ImportSessionFileCommand}" />
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Style="{DynamicResource Button.Hero}"
                        MinWidth="200"
                        Content="Search for Lost Data"
                        Command="{Binding StartScanCommand}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
