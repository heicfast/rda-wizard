<UserControl x:Class="RdaWizard.App.Views.FileRepairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="900">

    <!-- og PG-22 (screenshot: 02-landing/landing-sidebar-filerepair-page.png):
         3 repair options + blue Start CTA. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28,40,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Style="{DynamicResource Text.Title}" Text="File Repair" />
            <TextBlock Style="{DynamicResource Text.BodySecondary}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Text="Add corrupted files to easily repair them." />

            <ItemsControl ItemsSource="{Binding Options}" Margin="0,24,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16"
                                Margin="0,0,0,12"
                                CornerRadius="{DynamicResource Radius.Card}"
                                Background="{DynamicResource Brush.Bg.Card}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="{Binding Title}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{DynamicResource Button.Primary}"
                    Content="Start"
                    MinWidth="140"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    Command="{Binding StartCommand}" />

            <TextBlock Style="{DynamicResource Text.Caption}"
                       Margin="0,16,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Text="This build's engine provides volume-level repair: it analyzes the disk's file system and offers a transactional repair plan. Per-file video, photo and document repair is not part of this build's engine." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
