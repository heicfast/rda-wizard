<UserControl x:Class="RdaWizard.App.Views.MoreToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="900">

    <!-- og PG-21 (screenshot: 02-landing/landing-sidebar-moretools-page.png):
         6 tool cards — Crashed PC Rescue · NAS and Linux · RAID Recovery ·
         Cloud Recovery · Image Recovery · Disk Health. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28,40,24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Style="{DynamicResource Text.Title}" Text="More Recovery Tools" />

            <ItemsControl ItemsSource="{Binding Tools}" Margin="0,24,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{DynamicResource Button.Ghost}"
                                HorizontalContentAlignment="Stretch"
                                Margin="0,0,0,12"
                                Command="{Binding DataContext.ActivateToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Border Padding="16"
                                    CornerRadius="{DynamicResource Radius.Card}"
                                    Background="{DynamicResource Brush.Bg.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="{Binding Title}" />
                                        <TextBlock Style="{DynamicResource Text.Caption}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Description}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Style="{DynamicResource Text.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Visibility="{Binding IsAvailableInThisBuild, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                               Text="Not in this build" />
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
