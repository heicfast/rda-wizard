<UserControl x:Class="RdaWizard.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RdaWizard.Controls;assembly=RdaWizard.Controls"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <app:Converters.BoolToVisibilityConverter x:Key="BoolToVisibility" xmlns:app="clr-namespace:RdaWizard.App" />
        <app:Converters.NullToVisibilityConverter x:Key="NullToVisibility" xmlns:app="clr-namespace:RdaWizard.App" />
        <app:Converters.CountToVisibilityConverter x:Key="CountToVisibility" xmlns:app="clr-namespace:RdaWizard.App" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Style="{DynamicResource Text.Title}" Text="Disk health" />
            <TextBlock Style="{DynamicResource Text.BodySecondary}"
                       Text="Read-only diagnostics straight from the drive. Nothing here is modified — health is informational."
                       Margin="0,8,0,0" />
        </StackPanel>

        <!-- Loading -->
        <controls:StateSurface Grid.Row="1"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                               Glyph="&#xE945;"
                               Headline="Reading SMART data…"
                               Detail="The engine is querying the drive." />

        <!-- Error -->
        <controls:StateSurface Grid.Row="1"
                               Visibility="{Binding ErrorDiagnostic, Converter={StaticResource NullToVisibility}}"
                               IsError="True"
                               Glyph="&#xE7BA;"
                               Headline="Health could not be read"
                               Detail="{Binding ErrorDiagnostic}">

        </controls:StateSurface>

        <!-- Report present -->
        <Grid Grid.Row="1"
              Grid.RowSpan="2"
              Visibility="{Binding Report, Converter={StaticResource NullToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Warnings -->
            <Border Grid.Row="0"
                    Padding="12"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Background="{DynamicResource Brush.Status.DangerBg}"
                    Visibility="{Binding Report.Warnings.Count, Converter={StaticResource CountToVisibility}}">
                <ItemsControl ItemsSource="{Binding Report.Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{DynamicResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Status.DangerText}"
                                       Text="{Binding EngineText}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Aggregates / NVMe -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,16,0,16">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Text="TRIM" />
                    <TextBlock Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Text="{Binding Report.Trim}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Text="STORAGE TYPE" />
                    <TextBlock Style="{DynamicResource Text.Body}" FontWeight="SemiBold"
                               Text="{Binding Report.IsSsd, TargetNullValue='Unknown', StringFormat={}{0}}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Text="TEMPERATURE" />
                    <TextBlock Style="{DynamicResource Text.Body}" FontWeight="SemiBold"
                               Text="{Binding Report.Aggregates.TemperatureC, TargetNullValue='—', StringFormat={}{0} °C}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Text="POWER-ON HOURS" />
                    <TextBlock Style="{DynamicResource Text.Body}" FontWeight="SemiBold"
                               Text="{Binding Report.Aggregates.PowerOnHours, TargetNullValue=—}" />
                </StackPanel>
            </UniformGrid>

            <!-- SMART table -->
            <Border Grid.Row="2"
                    CornerRadius="{DynamicResource Radius.Card}"
                    Background="{DynamicResource Brush.Bg.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Hairline}"
                    BorderThickness="1">
                <ListView ItemsSource="{Binding Report.Attributes}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          AutomationProperties.Name="SMART attribute table">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" Width="60"
                                            DisplayMemberBinding="{Binding Id}" />
                            <GridViewColumn Header="Name" Width="280"
                                            DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Value" Width="80"
                                            DisplayMemberBinding="{Binding Value}" />
                            <GridViewColumn Header="Worst" Width="80"
                                            DisplayMemberBinding="{Binding Worst}" />
                            <GridViewColumn Header="Raw" Width="140"
                                            DisplayMemberBinding="{Binding Raw}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</UserControl>
