<UserControl x:Class="RdaWizard.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
    </UserControl.Resources>

    <Grid VerticalAlignment="Top"
          MaxWidth="{DynamicResource Content.MaxWidth}"
          HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Style="{DynamicResource Text.Display}" Text="RDA Data Recovery Wizard" />
            <TextBlock Style="{DynamicResource Text.BodySecondary}"
                       Text="{Binding ProductVersion, StringFormat=Version {0}}"
                       Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="16"
                CornerRadius="{DynamicResource Radius.Card}"
                Background="{DynamicResource Brush.Bg.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Style="{DynamicResource Text.Subtitle}" Text="Open-source licenses" Margin="0,0,0,8" />
                <TextBlock Style="{DynamicResource Text.BodySecondary}"
                           Text="This build uses MIT-licensed components. The full license text for every bundled library is available below."
                           TextWrapping="Wrap" />
                <Button Content="View licenses"
                        Height="{DynamicResource Height.XS}"
                        Padding="12,4"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0"
                        Command="{Binding ShowLicensesCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
