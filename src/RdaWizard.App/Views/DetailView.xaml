<UserControl x:Class="RdaWizard.App.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="900">

    <!-- TRANSITIONAL: scan-phase surface + results browser on one page (the
         og CDetailPage unification is in place; the full og chrome — toolbar,
         3-pane layout, filter bar, circular gauge bottom bar — lands in the
         detail-page phase). -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
        <conv:ByteSizeConverter x:Key="ByteSize" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
        <conv:NullableDateConverter x:Key="NullableDate" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: "Searching: <target>" -->
        <Border Grid.Row="0"
                Padding="20,10"
                Background="{DynamicResource Brush.Bg.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Style="{DynamicResource Text.Subtitle}"
                           Text="{Binding TargetName, StringFormat=Searching: {0}}" />
                <Button Style="{DynamicResource Button.Link}"
                        Content="Home"
                        HorizontalAlignment="Right"
                        Click="OnHomeClick" />
            </Grid>
        </Border>

        <!-- Scan phase: progress -->
        <StackPanel Grid.Row="1"
                    Visibility="{Binding IsScanRunning, Converter={StaticResource BoolToVisibility}}"
                    VerticalAlignment="Center"
                    Margin="40">
            <ProgressBar Style="{DynamicResource ProgressBar.Hero}"
                         Maximum="100"
                         Value="{Binding Percent, Mode=OneWay}" />
            <UniformGrid Columns="3" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Text="ELAPSED" />
                    <TextBlock Style="{DynamicResource Text.Numeral}" Text="{Binding ElapsedText}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Text="REMAINING" />
                    <TextBlock Style="{DynamicResource Text.Numeral}" Text="{Binding EtaText, TargetNullValue=—}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}" Text="READ ERRORS" />
                    <TextBlock Style="{DynamicResource Text.Numeral}" Text="{Binding ReadErrorCount}" />
                </StackPanel>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="Stop"
                        Command="{Binding CancelScanCommand}"
                        Margin="0,0,8,0" />
            </StackPanel>
        </StackPanel>

        <!-- Results phase: tree + list -->
        <Grid Grid.Row="1"
              Visibility="{Binding Session, Converter={StaticResource NullToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: path tree -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource Brush.Border.Hairline}"
                    BorderThickness="0,0,1,0">
                <TreeView ItemsSource="{Binding TreeRoots}"
                          VirtualizingPanel.IsVirtualizing="True">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- Right: file list -->
            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                <TextBlock Grid.Row="1"
                           Style="{DynamicResource Text.Caption}"
                           Margin="0,8,0,8"
                           Text="{Binding VisibleFileCount, StringFormat={}{0:N0} files}" />
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding VisibleFiles}"
                         SelectionMode="Extended"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Style="{DynamicResource Text.Caption}"
                                           Margin="16,0,0,0"
                                           Text="{Binding Timestamp, Converter={StaticResource NullableDate}}" />
                                <TextBlock Grid.Column="2"
                                           Style="{DynamicResource Text.Numeral}"
                                           Margin="16,0,0,0"
                                           Text="{Binding LogicalSize, Converter={StaticResource ByteSize}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Style="{DynamicResource Button.Link}"
                            Content="Save session copy…"
                            Command="{Binding SaveSessionCopyCommand}"
                            Margin="0,0,12,0" />
                    <Button Style="{DynamicResource Button.Hero}"
                            Content="Recover All"
                            Command="{Binding RecoverAllCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Completion line (og bottom bar: "Scan Completed, Files Found: …") -->
        <Border Grid.Row="2"
                Visibility="{Binding CompletionText, Converter={StaticResource NullToVisibility}}"
                Padding="20,8"
                Background="{DynamicResource Brush.Bg.SearchStrip}">
            <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="{Binding CompletionText}" />
        </Border>
    </Grid>
</UserControl>
