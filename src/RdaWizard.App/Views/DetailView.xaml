<UserControl x:Class="RdaWizard.App.Views.DetailView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RdaWizard.Controls;assembly=RdaWizard.Controls"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1024">

    <!-- og: CDetailPage (wizard stack index 3) — scan progress AND results on
         ONE surface ("browse-while-scanning"). Evidence: R-A PG-10 +
         03-scan-phase crop-VLM (toolbar, tree, bottom bar, paused diff).
         Chrome: "Searching:" header + CNavigateBar toolbar + 3-pane browser
         + CBottomArea (gauge / Stop / status text / Recover All ...).
         Sanctioned deltas (engine-truth): no Pause button (CLI has no pause
         flag — pause is library-only, R-B §1.3); no live "Searching: <file>"
         ticker strip (per-file paths are not on stdout); Recover All enabled
         only when a session is installed (G-02/G-03 forbid mid-scan
         recovery); results refresh at stage boundaries via the engine's
         auto-checkpoint (ADR-2). -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
        <conv:NullToBoolConverter x:Key="NullToBool" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
        <conv:ByteSizeConverter x:Key="ByteSize" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
        <conv:NullableDateConverter x:Key="NullableDate" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: "Searching: <target>" (og PG-10 header) -->
        <Border Grid.Row="0"
                Padding="16,8,16,8"
                Background="{DynamicResource Brush.Bg.Window}">
            <TextBlock Style="{DynamicResource Text.Subtitle}"
                       Text="{Binding TargetName, StringFormat=Searching: {0}}" />
        </Border>

        <!-- og CNavigateBar toolbar: Home/Back/Up cluster + breadcrumb +
             view toggle + Filter + search. Acts on the installed (partial or
             final) session — enabled as soon as results exist. -->
        <Border Grid.Row="1"
                Padding="12,6,12,6"
                Background="{DynamicResource Brush.Bg.Card}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Home / Back / Up cluster (og navigate_direction_button).
                     Home: landing (scan continues app-level); Back: history. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{DynamicResource Button.Icon}"
                            Click="OnHomeClick"
                            AutomationProperties.Name="Home"
                            ToolTip="Home">
                        <controls:Icon IconName="Icon.Nav.Home" IconSize="18" />
                    </Button>
                    <Button Style="{DynamicResource Button.Icon}"
                            Click="OnBackClick"
                            AutomationProperties.Name="Back"
                            ToolTip="Back">
                        <controls:Icon IconName="Icon.Nav.Back" IconSize="18" />
                    </Button>
                </StackPanel>

                <!-- Address breadcrumb (og CAddressBtn) -->
                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        CornerRadius="4"
                        Background="{DynamicResource Brush.Bg.SearchStrip}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon IconName="Icon.Device.Disk" IconSize="16"
                                       IconBrush="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock Text="{Binding Breadcrumb}"
                                   Style="{DynamicResource Text.BodySecondary}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- View toggle (og CIconListBtn) -->
                <Button Grid.Column="3"
                        Style="{DynamicResource Button.Icon}"
                        Command="{Binding ToggleViewModeCommand}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Switch view"
                        ToolTip="Switch view">
                    <controls:Icon IconName="Icon.Action.ViewList" IconSize="18" />
                </Button>

                <!-- Filter (og funnel + label — toggles the CFilterBar row) -->
                <Button Grid.Column="4"
                        Style="{DynamicResource Button.Secondary}"
                        Height="30"
                        Margin="0,0,8,0"
                        Command="{Binding ToggleFilterBarCommand}"
                        AutomationProperties.Name="Filter">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon IconName="Icon.Action.Filter" IconSize="16" />
                        <TextBlock Text="Filter" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Search (og CSearchLineedit: placeholder + clear) -->
                <controls:SearchField Grid.Column="5"
                                      Width="230"
                                      Height="30"
                                      Placeholder="Search files or folders"
                                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            </Grid>
        </Border>

        <!-- og CFilterBar (toggle-visible row below the toolbar): Show /
             File Type / Date Modified / File Size dropdowns + Reset Filter.
             Presets map truthfully onto the client-side FilterEvaluator. -->
        <Border Grid.Row="2"
                Visibility="{Binding FilterBarVisible, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource Brush.Bg.Card}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <ComboBox MinWidth="110" Height="30" AutomationProperties.Name="Show"
                          SelectionChanged="OnShowPick">
                    <ComboBoxItem Content="All" IsSelected="True" />
                    <ComboBoxItem Content="Existing" />
                    <ComboBoxItem Content="Deleted" />
                </ComboBox>
                <ComboBox MinWidth="120" Height="30" Margin="10,0,0,0" AutomationProperties.Name="File Type"
                          SelectionChanged="OnCategoryPick">
                    <ComboBoxItem Content="All Types" IsSelected="True" />
                    <ComboBoxItem Content="Photos" />
                    <ComboBoxItem Content="Videos" />
                    <ComboBoxItem Content="Documents" />
                    <ComboBoxItem Content="Audio" />
                    <ComboBoxItem Content="Archives" />
                    <ComboBoxItem Content="Email" />
                </ComboBox>
                <ComboBox MinWidth="140" Height="30" Margin="10,0,0,0" AutomationProperties.Name="Date Modified"
                          SelectionChanged="OnDatePick">
                    <ComboBoxItem Content="Any Date" IsSelected="True" />
                    <ComboBoxItem Content="Yesterday" />
                    <ComboBoxItem Content="Last 7 days" />
                    <ComboBoxItem Content="Last 1 month" />
                </ComboBox>
                <ComboBox MinWidth="140" Height="30" Margin="10,0,0,0" AutomationProperties.Name="File Size"
                          SelectionChanged="OnSizePick">
                    <ComboBoxItem Content="Any Size" IsSelected="True" />
                    <ComboBoxItem Content="&lt; 512KB" />
                    <ComboBoxItem Content="512KB~512MB" />
                    <ComboBoxItem Content="&gt; 512MB" />
                </ComboBox>
                <Button Style="{DynamicResource Button.Link}"
                        Content="Reset Filter"
                        Margin="16,0,0,0"
                        Command="{Binding ClearFilterCommand}" />
            </StackPanel>
        </Border>

        <!-- 3-pane browser: left tree / middle list / right preview.
             Panes fill from stage-boundary checkpoints while scanning
             (ADR-2) — empty until then. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Left: path tree (og CLeftTreeView — Path/Type tabs) -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource Brush.Border.Hairline}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Path / Type tabs (og tab strip — implicit TabItem style) -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource Brush.Border.Hairline}"
                            BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <TabControl Background="Transparent" BorderThickness="0">
                            <TabItem Header="Path">
                                <TabItem.Template>
                                    <ControlTemplate TargetType="TabItem">
                                        <ContentPresenter ContentSource="Header" />
                                    </ControlTemplate>
                                </TabItem.Template>
                            </TabItem>
                            <TabItem Header="Type">
                                <TabItem.Template>
                                    <ControlTemplate TargetType="TabItem">
                                        <ContentPresenter ContentSource="Header" />
                                    </ControlTemplate>
                                </TabItem.Template>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <!-- Tree roots with icon + name + count (og root rows:
                         'Windows (C:) 1.1M' / 'File Path Lost 4.3K') -->
                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding TreeRoots}"
                              VirtualizingPanel.IsVirtualizing="True"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedItemChanged="OnTreeItemSelected">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon IconName="{Binding IconKey}" IconKind="Solid" IconSize="16"
                                                   IconBrush="{DynamicResource Brush.Brand.Primary}" />
                                    <TextBlock Text="{Binding Name}"
                                               Style="{DynamicResource Text.Body}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CountText}"
                                               Style="{DynamicResource Text.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Middle: file list (og CListControl header + rows) -->
            <Grid Grid.Column="1" Margin="12,8,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column header: select-all + Name / Date Modified / Type / Size -->
                <Grid Grid.Row="0" Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Command="{Binding SelectAllVisibleCommand}"
                              AutomationProperties.Name="Select all files"
                              Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource Text.CaptionStrong}" Text="Name" />
                    <TextBlock Grid.Column="2" Style="{DynamicResource Text.CaptionStrong}" Text="Date Modified" />
                    <TextBlock Grid.Column="3" Style="{DynamicResource Text.CaptionStrong}" Text="Type" />
                    <TextBlock Grid.Column="4" Style="{DynamicResource Text.CaptionStrong}" Text="Size" TextAlignment="Right" />
                </Grid>

                <TextBlock Grid.Row="1"
                           Style="{DynamicResource Text.Caption}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,2,0,6"
                           Text="{Binding VisibleFileCount, StringFormat={}{0:N0} files}" />

                <!-- Loading / failure / rows -->
                <controls:StateSurface Grid.Row="2"
                                       Visibility="{Binding IsLoadingResults, Converter={StaticResource BoolToVisibility}}"
                                       Headline="Loading results…" />
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding VisibleFiles}"
                         SelectionMode="Extended"
                         BorderThickness="0"
                         Background="Transparent"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="{Binding Name}"
                                              Margin="0,0,10,0"
                                              VerticalAlignment="Center" />
                                    <controls:Icon IconName="{Binding IconKey}" IconKind="Solid" IconSize="16"
                                                   IconBrush="{DynamicResource Brush.Text.Secondary}"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Style="{DynamicResource Text.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="{Binding Timestamp, Converter={StaticResource NullableDate}}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Style="{DynamicResource Text.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="{Binding TypeText}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3"
                                           Style="{DynamicResource Text.Numeral}"
                                           Margin="16,0,0,0"
                                           Text="{Binding LogicalSize, Converter={StaticResource ByteSize}}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />
                                <!-- og context menu (CShowContextMenu, 6 documented
                                     items — R-A PG-10): Recover / Preview / Open
                                     file location / Select unrecovered files /
                                     Smart select best files / Clear selection -->
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Recover"
                                                  Command="{Binding DataContext.RecoverCommand, Source={x:Reference Root}}" />
                                        <MenuItem Header="Preview"
                                                  Command="{Binding DataContext.PreviewCommand, Source={x:Reference Root}}"
                                                  CommandParameter="{Binding Node}" />
                                        <MenuItem Header="Open file location"
                                                  Command="{Binding DataContext.OpenLocationCommand, Source={x:Reference Root}}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Select unrecovered files"
                                                  Command="{Binding DataContext.SelectUnrecoveredCommand, Source={x:Reference Root}}" />
                                        <MenuItem Header="Smart select best files"
                                                  Command="{Binding DataContext.SelectBestCommand, Source={x:Reference Root}}" />
                                        <MenuItem Header="Clear selection"
                                                  Command="{Binding DataContext.ClearSelectionCommand, Source={x:Reference Root}}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Right: preview pane (og CRightContent). Folder state: big
                 icon + name + Size + Open. File state: icon + name +
                 Recovery Chances + Size / Date Modified / Path / Status.
                 No thumbnail rendering: the preview reader is library-only
                 (no CLI projection, R-B §2.6) — the file-type icon is the
                 truthful surface. -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource Brush.Border.Hairline}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource Brush.Bg.Card}"
                    Visibility="{Binding PreviewItem, Converter={StaticResource NullToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12">

                        <!-- Icon + name -->
                        <controls:Icon IconName="{Binding PreviewItem.IconKey}" IconKind="Solid" IconSize="72"
                                       HorizontalAlignment="Center"
                                       IconBrush="{DynamicResource Brush.Brand.Primary}" />
                        <TextBlock Text="{Binding PreviewItem.Name}"
                                   Style="{DynamicResource Text.BodyStrong}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <!-- Folder state: Open (scopes the list to it) -->
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="Open"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0"
                                Command="{Binding OpenPreviewFolderCommand}"
                                CommandParameter="{Binding PreviewItem}"
                                Visibility="{Binding PreviewItem.IsFolder, Converter={StaticResource BoolToVisibility}}" />

                        <!-- File state: metadata stack (og row order) -->
                        <StackPanel Visibility="{Binding PreviewItem.IsFolder, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                    Margin="0,12,0,0">
                            <TextBlock Style="{DynamicResource Text.Caption}" Text="Recovery Chances" />
                            <Border Style="{DynamicResource Badge.Tag}" Margin="0,2,0,10"
                                    HorizontalAlignment="Left">
                                <TextBlock Style="{DynamicResource Text.CaptionStrong}"
                                           Text="{Binding PreviewItem.RecoveryChances, StringFormat=Recovery Chances: {0}}" />
                            </Border>

                            <TextBlock Style="{DynamicResource Text.Caption}" Text="Size" />
                            <TextBlock Style="{DynamicResource Text.Body}"
                                       Margin="0,2,0,8"
                                       Text="{Binding PreviewItem.Size, Converter={StaticResource ByteSize}}" />

                            <TextBlock Style="{DynamicResource Text.Caption}" Text="Date Modified" />
                            <TextBlock Style="{DynamicResource Text.Body}"
                                       Margin="0,2,0,8"
                                       Text="{Binding PreviewItem.Date, Converter={StaticResource NullableDate}}" />

                            <TextBlock Style="{DynamicResource Text.Caption}" Text="Path" />
                            <TextBlock Style="{DynamicResource Text.Body}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Margin="0,2,0,8"
                                       Text="{Binding PreviewItem.Path}"
                                       TextWrapping="Wrap" />

                            <TextBlock Style="{DynamicResource Text.Caption}" Text="Status" />
                            <TextBlock Style="{DynamicResource Text.Body}"
                                       Margin="0,2,0,0"
                                       Text="{Binding PreviewItem.Status}" />
                        </StackPanel>

                        <!-- Folder state: Size row -->
                        <StackPanel Visibility="{Binding PreviewItem.IsFolder, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,12,0,0">
                            <TextBlock Style="{DynamicResource Text.Caption}" Text="Size" />
                            <TextBlock Style="{DynamicResource Text.Body}"
                                       Margin="0,2,0,0"
                                       Text="{Binding PreviewItem.Size, Converter={StaticResource ByteSize}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- og CBottomArea: gauge + Stop + status text + contextual
             Recover CTA (540-family bottom bar, top separator, white). -->
        <Border Grid.Row="4"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Brush.Bg.Card}"
                Padding="16,10,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Gauge: og 56-64px ring with % inside. Visible while
                     scanning (and briefly at completion). -->
                <controls:CircularGauge Grid.Column="0"
                                        Width="56" Height="56"
                                        Value="{Binding Percent}"
                                        Label="{Binding PercentLabel}"
                                        Visibility="{Binding IsScanRunning, Converter={StaticResource BoolToVisibility}}" />

                <!-- Stop (og ■ button — destructive confirm via the shell). -->
                <Button Grid.Column="1"
                        Style="{DynamicResource Button.Icon}"
                        Click="OnStopClick"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsScanRunning, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Stop scan"
                        ToolTip="Stop">
                    <controls:Icon IconName="Icon.Scan.Stop" IconSize="20"
                                   IconBrush="{DynamicResource Brush.Text.Primary}" />
                </Button>

                <!-- Status text: og two-line stack. -->
                <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource Text.BodyStrong}"
                               Text="{Binding StatusPrimary, TargetNullValue=''}" />
                    <TextBlock Style="{DynamicResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,2,0,0"
                               Text="{Binding StatusSecondary, TargetNullValue=''}" />
                </StackPanel>

                <!-- Contextual Recover CTA (og: "Recover All ..." with no
                     selection, "Recover ..." with checked rows; enabled only
                     with results — G-02/G-03 truthful gate). -->
                <Button Grid.Column="3"
                        Style="{DynamicResource Button.Hero}"
                        MinWidth="170" Height="34"
                        Content="{Binding RecoverCtaLabel}"
                        Command="{Binding RecoverCommand}"
                        IsEnabled="{Binding Session, Converter={StaticResource NullToBool}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
