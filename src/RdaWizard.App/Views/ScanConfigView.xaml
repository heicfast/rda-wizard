<UserControl x:Class="RdaWizard.App.Views.ScanConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RdaWizard.Core.Models;assembly=RdaWizard.Core"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:EnumMatchConverter x:Key="ScanModeToBool" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: target recap -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Style="{DynamicResource Text.Title}" Text="How thoroughly should we search?" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Style="{DynamicResource Text.BodySecondary}"
                           Text="Scanning target: " />
                <TextBlock Style="{DynamicResource Text.Body}"
                           FontWeight="SemiBold"
                           Text="{Binding Target.Description, TargetNullValue=none}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="{DynamicResource Content.MaxWidth}" HorizontalAlignment="Left">

                <!-- ===== Scan modes (radio cards — exactly the engine's three stages) ===== -->
                <TextBlock Style="{DynamicResource Text.Subtitle}" Text="Scan type" Margin="0,0,0,12" />
                <StackPanel>
                    <RadioButton GroupName="ScanMode"
                                 IsChecked="{Binding Mode, ConverterParameter={x:Static models:ScanMode.Quick}, Converter={StaticResource ScanModeToBool}}"
                                 Padding="14,10"
                                 Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Text="Quick scan" />
                            <TextBlock Style="{DynamicResource Text.Caption}" Text="Fast scan of the file tables — best when the disk just lost files." TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ScanMode"
                                 IsChecked="{Binding Mode, ConverterParameter={x:Static models:ScanMode.Deep}, Converter={StaticResource ScanModeToBool}}"
                                 Padding="14,10"
                                 Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Text="Deep scan" />
                            <TextBlock Style="{DynamicResource Text.Caption}" Text="Thorough scan without raw carving — good when the filesystem is damaged but present." TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ScanMode"
                                 IsChecked="{Binding Mode, ConverterParameter={x:Static models:ScanMode.DeepPlusCarve}, Converter={StaticResource ScanModeToBool}}"
                                 Padding="14,10">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Text="Deep scan + signature search" />
                            <TextBlock Style="{DynamicResource Text.Caption}" Text="Thorough scan plus signature search for files the filesystem no longer references — the most complete, takes longest." TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- ===== File category pre-selection (carried into results filter) ===== -->
                <TextBlock Style="{DynamicResource Text.Subtitle}" Text="File types to look for" Margin="0,24,0,4" />
                <TextBlock Style="{DynamicResource Text.Caption}"
                           Text="All types are recovered either way — these chips shape the results view right after the scan."
                           Margin="0,0,0,12" />
                <WrapPanel>
                    <Button Style="{DynamicResource {x:Type Button}}"
                            Height="{DynamicResource Height.XS}"
                            Padding="14,4"
                            Margin="0,0,8,8"
                            Content="Photos"
                            Command="{Binding ToggleCategoryCommand}"
                            CommandParameter="{x:Static models:FileCategory.Photos}" />
                    <Button Style="{DynamicResource {x:Type Button}}"
                            Height="{DynamicResource Height.XS}"
                            Padding="14,4"
                            Margin="0,0,8,8"
                            Content="Videos"
                            Command="{Binding ToggleCategoryCommand}"
                            CommandParameter="{x:Static models:FileCategory.Videos}" />
                    <Button Style="{DynamicResource {x:Type Button}}"
                            Height="{DynamicResource Height.XS}"
                            Padding="14,4"
                            Margin="0,0,8,8"
                            Content="Documents"
                            Command="{Binding ToggleCategoryCommand}"
                            CommandParameter="{x:Static models:FileCategory.Documents}" />
                    <Button Style="{DynamicResource {x:Type Button}}"
                            Height="{DynamicResource Height.XS}"
                            Padding="14,4"
                            Margin="0,0,8,8"
                            Content="Audio"
                            Command="{Binding ToggleCategoryCommand}"
                            CommandParameter="{x:Static models:FileCategory.Audio}" />
                    <Button Style="{DynamicResource {x:Type Button}}"
                            Height="{DynamicResource Height.XS}"
                            Padding="14,4"
                            Margin="0,0,8,8"
                            Content="Archives"
                            Command="{Binding ToggleCategoryCommand}"
                            CommandParameter="{x:Static models:FileCategory.Archives}" />
                    <Button Style="{DynamicResource {x:Type Button}}"
                            Height="{DynamicResource Height.XS}"
                            Padding="14,4"
                            Margin="0,0,8,8"
                            Content="Email"
                            Command="{Binding ToggleCategoryCommand}"
                            CommandParameter="{x:Static models:FileCategory.Email}" />
                </WrapPanel>

                <!-- ===== Advanced (truthful: only knobs the engine accepts) ===== -->
                <Expander Header="Advanced options"
                          Margin="0,16,0,0"
                          IsExpanded="False">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Style="{DynamicResource Text.Body}" Text="Name filter" Margin="0,0,0,4" />
                        <TextBox Width="360"
                                 HorizontalAlignment="Left"
                                 Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Only files whose names contain this text are scanned (--filter)" />
                        <TextBlock Style="{DynamicResource Text.Caption}"
                                   Text="Optional. Pushed into the engine scan itself."
                                   Margin="0,4,0,0" />

                        <CheckBox Content="Deleted files only"
                                  IsChecked="{Binding DeletedOnly}"
                                  Margin="0,12,0,0"
                                  ToolTip="Engine-side filter (--deleted-only)" />

                        <TextBlock Style="{DynamicResource Text.Body}" Text="Worker threads" Margin="0,12,0,4" />
                        <TextBox Width="120"
                                 HorizontalAlignment="Left"
                                 Text="{Binding Threads, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="0 = engine default; 1–64 explicit (engine contract)" />
                        <TextBlock Style="{DynamicResource Text.Caption}"
                                   Text="0 lets the engine choose. Values 1–64 are honored."
                                   Margin="0,4,0,0" />

                        <!-- Read policy: truthful INFORMATION, not fake controls (ADR-4). -->
                        <Border Margin="0,16,0,0"
                                Padding="12"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Background="{DynamicResource Brush.Bg.SearchStrip}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.Caption}"
                                           FontWeight="SemiBold"
                                           Text="Read policy (fixed by the engine)" />
                                <TextBlock Style="{DynamicResource Text.Caption}"
                                           Text="Damaged areas are retried automatically and skipped only after the engine's retry limit is exhausted. Read-error ranges are shown live during the scan and summarized in the session."
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="16"
                CornerRadius="{DynamicResource Radius.Card}"
                Background="{DynamicResource Brush.Bg.Window}"
                BorderBrush="{DynamicResource Brush.Border.Hairline}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{DynamicResource Text.BodySecondary}"
                           VerticalAlignment="Center"
                           Text="{Binding RefusalReason, TargetNullValue=Deep scan + signature search is the most complete option.}" />
                <Button Grid.Column="1"
                        Style="{DynamicResource Button.Primary}"
                        Click="OnStartScanClick"
                        Content="Start scan" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
