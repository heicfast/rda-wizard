<UserControl x:Class="RdaWizard.App.Views.CompletionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RdaWizard.Controls;assembly=RdaWizard.Controls"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
    </UserControl.Resources>

    <Grid VerticalAlignment="Top"
          MaxWidth="{DynamicResource Content.MaxWidth}"
          HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Outcome banner -->
        <Border Grid.Row="0"
                Padding="20,16"
                CornerRadius="{DynamicResource Radius.Card}"
                Background="{DynamicResource Brush.Status.SuccessBg}">
            <StackPanel>
                <TextBlock Style="{DynamicResource Text.Title}"
                           Foreground="{DynamicResource Brush.Status.SuccessText}"
                           Text="{Binding Headline}" />
                <TextBlock Style="{DynamicResource Text.Body}"
                           Foreground="{DynamicResource Brush.Status.SuccessText}"
                           Text="{Binding Detail}"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Issues detail (partial/failed) -->
        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="16"
                CornerRadius="{DynamicResource Radius.Card}"
                Background="{DynamicResource Brush.Status.WarningBg}"
                Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{DynamicResource Text.Subtitle}"
                           Foreground="{DynamicResource Brush.Status.WarningText}"
                           Text="What to check" />
                <TextBlock Style="{DynamicResource Text.Caption}"
                           Foreground="{DynamicResource Brush.Status.WarningText}"
                           Text="Files that could not be read usually sit on damaged areas of the disk — see the read-error list from the scan. Hash mismatches mean the recovered copy differs from what was stored: open the report for the exact counts."
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Report -->
        <StackPanel Grid.Row="2" Margin="0,24,0,0">
            <TextBlock Style="{DynamicResource Text.Subtitle}" Text="Recovery report" Margin="0,0,0,8" />
            <TextBlock Style="{DynamicResource Text.Caption}"
                       Text="A plain-text report with every count and the engine's safety notes was written next to the recovered files (recovery-report.txt)."
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,24,0,0">
            <Button Style="{DynamicResource Button.Primary}"
                    Content="Open destination folder"
                    Command="{Binding OpenDestinationCommand}"
                    Margin="0,0,8,0" />
            <Button Content="Back to results"
                    Margin="0,0,8,0"
                    Click="OnBackToResultsClick"
                    ToolTip="Recover more files from the same scan session" />
            <Button Style="{DynamicResource Button.Hero}"
                    Content="Finish"
                    Click="OnFinishClick" />
        </StackPanel>

        <!-- Cancelled note -->
        <Border Grid.Row="4"
                Margin="0,16,0,0"
                Padding="12"
                CornerRadius="{DynamicResource Radius.Control}"
                Background="{DynamicResource Brush.Bg.SearchStrip}"
                Visibility="{Binding WasCancelled, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{DynamicResource Text.Caption}"
                       Text="Cancelled part-way: the files that finished writing are complete and remain in the destination folder." />
        </Border>
    </Grid>
</UserControl>
