<UserControl x:Class="RdaWizard.App.Views.SdCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="900">

    <!-- og PG-20 (02-landing/landing-sidebar-sdcard-page.png): coaching
         title + subtitle + 3 feature tiles (SDR/SSR/DVR tags) + links. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28,40,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Style="{DynamicResource Text.Title}"
                       Text="{Binding Title}"
                       TextWrapping="Wrap" />
            <TextBlock Style="{DynamicResource Text.BodySecondary}"
                       Margin="0,8,0,0"
                       Text="{Binding Subtitle}"
                       TextWrapping="Wrap" />

            <UniformGrid Columns="3" Margin="0,24,0,0">
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16" CornerRadius="{DynamicResource Radius.Card}"
                                    Background="{DynamicResource Brush.Bg.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <Border Style="{DynamicResource Badge.Tag}"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,8">
                                        <TextBlock Style="{DynamicResource Text.Micro}" Text="{Binding Tag}" />
                                    </Border>
                                    <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="{Binding Title}" />
                                    <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{Binding Description}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </UniformGrid>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <TextBlock Style="{DynamicResource Text.BodySecondary}"
                           VerticalAlignment="Center"
                           Text="SD card connected but not detected?" />
                <Button Style="{DynamicResource Button.Link}" Content="Show all external devices" Click="OnShowAllDevicesClick" Margin="8,0,0,0" />
                <TextBlock Style="{DynamicResource Text.BodySecondary}" VerticalAlignment="Center" Text=" or " />
                <Button Style="{DynamicResource Button.Link}" Content="Get Help" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
