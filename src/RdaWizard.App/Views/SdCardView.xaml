<UserControl x:Class="RdaWizard.App.Views.SdCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="900">

    <!-- og PG-20 (screenshot: 02-landing/landing-sidebar-sdcard-page.png):
         coaching title + device illustration + 3 feature tiles + links. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28,40,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Style="{DynamicResource Text.Title}"
                       Text="Connect Your Memory Card to Recover Lost Photos &amp; Videos"
                       TextWrapping="Wrap" />

            <UniformGrid Columns="3" Margin="0,24,0,0">
                <Border Padding="16" CornerRadius="{DynamicResource Radius.Card}"
                        Background="{DynamicResource Brush.Bg.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="Fix SD card access" />
                        <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Repair access errors that make the card unreadable" />
                    </StackPanel>
                </Border>
                <Border Padding="16" CornerRadius="{DynamicResource Radius.Card}"
                        Background="{DynamicResource Brush.Bg.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="Photos that open" />
                        <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Recover photos that display correctly after recovery" />
                    </StackPanel>
                </Border>
                <Border Padding="16" CornerRadius="{DynamicResource Radius.Card}"
                        Background="{DynamicResource Brush.Bg.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.BodyStrong}" Text="Video that play" />
                        <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Recover videos that play without corruption" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Style="{DynamicResource Button.Link}" Content="Show all external devices" Click="OnShowAllDevicesClick" />
                <Button Style="{DynamicResource Button.Link}" Content="Get Help" Margin="16,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
