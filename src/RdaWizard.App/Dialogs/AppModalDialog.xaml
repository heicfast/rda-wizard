<Window x:Class="RdaWizard.App.Dialogs.AppModalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="540"
        MinHeight="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!-- og message-box family (DrwNewMessageBox / DrwMessageBox, 540x240
         fixed, custom chrome): icon + title + body + button row with
         CUSTOM labels; destructive confirm renders the danger action
         (og stop-scan: Stop pink + Continue blue). -->
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" xmlns:conv="clr-namespace:RdaWizard.App.Converters" />
    </Window.Resources>

    <Border Margin="16"
            Background="{DynamicResource Brush.Bg.Card}"
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                              Opacity="0.16" Color="#1F2329" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,20,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Severity icon: question (confirm) / info (alert) / warning (destructive) -->
                <Path Grid.Column="0"
                      x:Name="SeverityGlyph"
                      Data="M 12 2 C 6.5 2 2 6.5 2 12 C 2 17.5 6.5 22 12 22 C 17.5 22 22 17.5 22 12 C 22 6.5 17.5 2 12 2 Z M 12 4 C 16.4 4 20 7.6 20 12 C 20 16.4 16.4 20 12 20 C 7.6 20 4 16.4 4 12 C 4 7.6 7.6 4 12 4 Z M 11 6.5 L 13 6.5 L 13 8.5 L 11 8.5 Z M 11 10 L 13 10 L 13 17.5 L 11 17.5 Z"
                      Fill="{DynamicResource Brush.Brand.Primary}"
                      Width="28" Height="28"
                      VerticalAlignment="Top"
                      Margin="0,2,16,0"
                      Stretch="Uniform" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DialogTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{DynamicResource Text.Header}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{DynamicResource Text.Body}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

            <!-- Button row: cancel (left of primary, outline) + confirm (primary /
                 danger). Custom labels — never stock OK/Cancel. -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,8,24,20">
                <Button x:Name="CancelButton"
                        Style="{DynamicResource Button.Secondary}"
                        MinWidth="120" Height="34"
                        Content="{Binding CancelLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                        IsCancel="True"
                        Click="OnCancel" />
                <Button x:Name="ConfirmButton"
                        Style="{DynamicResource Button.Hero}"
                        MinWidth="120" Height="34"
                        Margin="12,0,0,0"
                        Content="{Binding ConfirmLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                        IsDefault="True"
                        Click="OnConfirm" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
