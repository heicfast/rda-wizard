<Project Sdk="Microsoft.NET.Sdk">

  <!-- RdaWizard.Integration — engine bindings: rrecov CLI subprocess host,
       output parsers (frozen contract), driver status probe, destination
       overlap gate. No WPF references. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RdaWizard.Integration</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- P/Invoke surfaces are Windows-only at runtime; the code compiles
         everywhere and guards execution with OperatingSystem.IsWindows(). -->
    <SupportedPlatforms>windows</SupportedPlatforms>
    <!-- LibraryImport source-generated P/Invoke requires unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RdaWizard.Core\RdaWizard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contract tests exercise the exact CLI flag builder. -->
    <InternalsVisibleTo Include="RdaWizard.Integration.Tests" />
  </ItemGroup>

  <ItemGroup Label="Windows interop">
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
